# shellcheck shell=sh
# The sourcing script sets the variables below, so shellcheck can't see them assigned here.
# shellcheck disable=SC2154
# The cases every build of ears-check must agree with the JVM jar on, sourced by check-npm-cli,
# check-native-cli, and check-coursier-app. The sourcing script sets:
#   check       its own name, for messages;
#   subject     the build under test (node, native, coursier), whose command is the function
#               ${subject}_cli;
#   label       that build's name in messages ("the Node CLI");
#   tmp, jar    a temporary directory it removes, and the JVM jar.
# Each case runs both builds and stops at the first difference, showing both sides.

# Scala 3's runtime uses sun.misc.Unsafe, which JDK 23 and newer warn about on every start
# unless --sun-misc-unsafe-memory-access=allow. JDK 17 through 22 don't know that flag and
# won't start with it, so -XX:+IgnoreUnrecognizedVMOptions makes them skip it.
jvm_cli() {
  java -XX:+IgnoreUnrecognizedVMOptions --sun-misc-unsafe-memory-access=allow -jar "$jar" "$@"
}

# Inputs: plain text, a passing file, a directory, every spec as OpenSpec JSON, and OpenSpec JSON
# fixtures with findings.
inputs="$tmp/inputs"
mkdir -p "$inputs/notes"
printf '%s\n' 'The scheduler shall list upcoming events.' 'The scheduler lists events.' \
  'When a payment fails the billing service SHALL notify the account owner.' >"$inputs/plain.txt"
printf '%s\n' 'The scheduler shall list upcoming events.' >"$inputs/passing.txt"
for spec in $(openspec list --specs --json | jq -r '.specs[].id'); do
  openspec show "$spec" --type spec --json >"$inputs/spec-$spec.json"
done
# OpenSpec JSON with findings, in `openspec show --json`'s shape (the real specs have none, since
# check-openspec holds them to zero): a change with a failing ADDED delta (a missing comma), a
# failing MODIFIED one (a weak modal), and a REMOVED one, which has no text to check; and a spec
# with a passing requirement and a failing one (an If clause with no comma or "then").
printf '%s\n' '{"id": "add-reminders", "title": "add-reminders", "deltaCount": 3, "deltas": [' \
  '{"spec": "reminders", "operation": "ADDED", "description": "Add requirement",' \
  ' "requirement": {"name": "Reminder sent", "scenarios": [],' \
  '  "text": "When a reminder is due the scheduler SHALL send a notice."}},' \
  '{"spec": "reminders", "operation": "MODIFIED", "description": "Modify requirement",' \
  ' "requirement": {"name": "Upcoming", "scenarios": [],' \
  '  "text": "The scheduler SHOULD list upcoming events in order."}},' \
  '{"spec": "reminders", "operation": "REMOVED", "description": "Remove requirement",' \
  ' "requirement": {"name": "Old reminder"}}' \
  ']}' >"$inputs/fixture-change.json"
printf '%s\n' '{"id": "invoices", "title": "invoices", "requirementCount": 2, "requirements": [' \
  '{"name": "Issue", "scenarios": [],' \
  ' "text": "The billing service SHALL issue an invoice each month."},' \
  '{"name": "Overdue", "scenarios": [],' \
  ' "text": "If an invoice is overdue the billing service SHALL notify the account owner."}' \
  ']}' >"$inputs/fixture-spec.json"

# Runs one build on a case, with $stdin piped to it: <build>/<case>.out, .err (with log lines
# removed), and .status. Log lines start with an ISO timestamp and a level; their details differ
# by platform, by design.
run() {
  build=$1 name=$2
  shift 2
  mkdir -p "$tmp/$build"
  # The pipeline's status is the CLI's, the last command's.
  status=0
  cat "$stdin" | "${build}_cli" "$@" >"$tmp/$build/$name.out" 2>"$tmp/$build/$name.log" ||
    status=$?
  echo "$status" >"$tmp/$build/$name.status"
  grep -v -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z (TRACE|DEBUG|INFO|WARN|ERROR|FATAL) ' \
    "$tmp/$build/$name.log" >"$tmp/$build/$name.err" || true
}

# Runs both builds on a case and stops at the first difference, showing both sides. EXPECTED is
# the exit statuses the case may end with, separated by spaces: agreeing isn't enough, since both
# builds failing the same way would hide every other difference.
compare() {
  name=$1 expected=$2
  shift 2
  run "$subject" "$name" "$@"
  run jvm "$name" "$@"
  for part in status out err; do
    if ! cmp -s "$tmp/$subject/$name.$part" "$tmp/jvm/$name.$part"; then
      echo "$check: case $name: $label's $part differs from the JVM CLI's" >&2
      echo "(< $subject, > JVM)" >&2
      diff "$tmp/$subject/$name.$part" "$tmp/jvm/$name.$part" | head -40 >&2 || true
      exit 1
    fi
  done
  status=$(cat "$tmp/$subject/$name.status")
  for allowed in $expected; do
    if [ "$status" = "$allowed" ]; then
      echo "$check: $name: the same (exit status $status)"
      return
    fi
  done
  echo "$check: case $name: both builds exited with $status, not $expected:" >&2
  cat "$tmp/$subject/$name.err" >&2
  exit 1
}

# Every tracked Markdown file, which must exist (a deletion not yet staged is still tracked) and
# have no space or glob character in its path: the list is split into arguments below.
markdown=$(git ls-files '*.md')
for file in $markdown; do
  case $file in
    *[[:space:]*?[]*)
      echo "$check: $file: a path with a space or glob character can't be passed" >&2
      exit 1
      ;;
  esac
  if [ ! -f "$file" ]; then
    echo "$check: $file is tracked but missing; restore or stage its deletion" >&2
    exit 1
  fi
done
specs=$(ls "$inputs"/spec-*.json)

# A file the user may not read; root reads it anyway, so the case is skipped for root.
printf '%s\n' 'The scheduler shall list upcoming events.' >"$inputs/secret.txt"
chmod 000 "$inputs/secret.txt"
# Invalid UTF-8: "\351" is é in Latin-1.
printf 'The scheduler shall list \351vents.\nThe scheduler lists \351vents.\n' >"$inputs/latin1.txt"
# UTF-16 with its byte-order mark ("Sch"), and plain text after a UTF-8 byte-order mark.
printf '\377\376S\000c\000h\000\n\000' >"$inputs/utf16.txt"
printf '\357\273\277Scheduler shall list events.\n' >"$inputs/bom.txt"

stdin=/dev/null
set -f # the lists below are split into arguments but never globbed
# shellcheck disable=SC2086
compare markdown-text "0 1" $markdown
# shellcheck disable=SC2086
compare markdown-json "0 1" --output json $markdown
# The real specs, as the large case: check-openspec holds them to zero findings.
# shellcheck disable=SC2086
compare openspec-json 0 --output json $specs
set +f
compare openspec-change-text 1 "$inputs/fixture-change.json"
compare openspec-change-json 1 --output json "$inputs/fixture-change.json"
compare openspec-spec-text 1 "$inputs/fixture-spec.json"
compare openspec-spec-json 1 --output json "$inputs/fixture-spec.json"
compare plain-text 1 "$inputs/plain.txt"
compare plain-json 1 --output json "$inputs/plain.txt"
# A Markdown table: a requirement in a cell with a missing comma (a finding), and a body row with
# more cells than its header (a warning). Both agreeing isn't enough: the warning must be there.
printf '%s\n' '| Name | Requirement |' '| --- | --- |' \
  '| A | When an order arrives the scheduler shall list events. |' \
  '| C | one | two | three |' >"$inputs/table.md"
compare markdown-table-text 1 "$inputs/table.md"
compare markdown-table-json 1 --output json "$inputs/table.md"
if ! grep -q ':4: warning: table-extra-cells: ' "$tmp/$subject/markdown-table-text.out"; then
  echo "$check: case markdown-table-text: no warning for the row with extra cells" >&2
  exit 1
fi
compare invalid-utf-8 2 "$inputs/latin1.txt"
compare utf-16 2 "$inputs/utf16.txt"
# A .json file that isn't OpenSpec JSON: the message names it.
printf '{not json' >"$inputs/not-openspec.json"
compare not-openspec-json 2 "$inputs/not-openspec.json"
if ! grep -q -F "Cannot parse $inputs/not-openspec.json: not OpenSpec change or spec JSON: " \
  "$tmp/$subject/not-openspec-json.err"; then
  echo "$check: case not-openspec-json: the message doesn't name the file" >&2
  cat "$tmp/$subject/not-openspec-json.err" >&2
  exit 1
fi
compare byte-order-mark 1 "$inputs/bom.txt"
# Both builds agreeing isn't enough here: the fix must not carry the mark.
if LC_ALL=C grep -q "$(printf '\357\273\277')" "$tmp/$subject/byte-order-mark.out"; then
  echo "$check: case byte-order-mark: the fix still has the byte-order mark" >&2
  exit 1
fi
# OpenSpec JSON after a UTF-8 byte-order mark: read as if it weren't there.
set -f
for spec in $specs; do
  { printf '\357\273\277'; cat "$spec"; } >"$inputs/bom.json"
  break
done
set +f
compare openspec-byte-order-mark 0 --output json "$inputs/bom.json"
# A requirement carrying terminal escape sequences (ESC [2K ESC [1A) and a missing comma: its fix
# must show them as \u001b, so no build writes the escape character itself.
printf 'When an order arrives the scheduler shall list events \033[2K\033[1A.\n' \
  >"$inputs/escapes.txt"
compare escape-sequences 1 "$inputs/escapes.txt"
if LC_ALL=C grep -q "$(printf '\033')" "$tmp/$subject/escape-sequences.out"; then
  echo "$check: case escape-sequences: the output still has the escape character" >&2
  exit 1
fi
# A vertical tab between two words of a requirement with a missing comma: every build shows one
# space in the fix (Scala Native's regex \s has no vertical tab, so the code doesn't use it).
printf 'When an order\013arrives the scheduler shall list events.\n' >"$inputs/vertical-tab.txt"
compare vertical-tab 1 "$inputs/vertical-tab.txt"
# An OpenSpec requirement in classic case holding a lone surrogate, a C1 control (CSI), and a line
# separator, given as JSON escapes: under the OpenSpec profile its fix quotes them, and every build
# shows each as \uXXXX in text output and as a JSON escape in JSON output (a lone surrogate would
# otherwise be ? from the JVM and U+FFFD from Node).
printf '%s\n' '{"id": "reminders", "requirements": [{"name": "Upcoming",' \
  ' "text": "The scheduler shall list [\ud83d] [\u009b] [\u2028] events."}]}' \
  >"$inputs/lone-surrogate.json"
compare lone-surrogate-text 1 --profile openspec "$inputs/lone-surrogate.json"
compare lone-surrogate-json 1 --profile openspec --output json "$inputs/lone-surrogate.json"
for output in text json; do
  if ! grep -qF '[\ud83d] [\u009b] [\u2028]' "$tmp/$subject/lone-surrogate-$output.out"; then
    echo "$check: case lone-surrogate-$output: the output doesn't show the escapes" >&2
    exit 1
  fi
done
# A requirement with a missing comma holding a right-to-left override (RLO), a left-to-right
# isolate (LRI), and a right-to-left mark (RLM), written as their UTF-8 bytes so this file holds
# none: every build shows all three as \uXXXX in text and JSON output (the mark too, since it's
# outside the English character set).
printf 'When an order arrives the scheduler shall list [\342\200\256] [\342\201\246] [\342\200\217] events.\n' \
  >"$inputs/bidirectional.txt"
compare bidirectional-text 1 "$inputs/bidirectional.txt"
compare bidirectional-json 1 --output json "$inputs/bidirectional.txt"
for output in text json; do
  if ! grep -qF "[\\u202e] [\\u2066] [\\u200f]" "$tmp/$subject/bidirectional-$output.out"; then
    echo "$check: case bidirectional-$output: the output doesn't show the escapes" >&2
    exit 1
  fi
  if LC_ALL=C grep -q -e "$(printf '\342\200\256')" -e "$(printf '\342\201\246')" \
    -e "$(printf '\342\200\217')" "$tmp/$subject/bidirectional-$output.out"; then
    echo "$check: case bidirectional-$output: the output still has RLO, LRI, or RLM" >&2
    exit 1
  fi
done
# A requirement with a missing comma holding the English character set's curly quotes, an em
# dash, and an accented letter, which every build keeps; and an emoji, a zero-width space, a
# Cyrillic a, and a GitHub Actions command marker, which every build escapes, with text and JSON
# output alike. Written as UTF-8 bytes, so this file holds none of them.
printf 'When an order arrives the scheduler shall list \342\200\234events\342\200\235 \342\200\224 at the caf\303\251 \360\237\230\200 ev\342\200\213ents for d\320\260ys ##[error] now.\n' \
  >"$inputs/english.txt"
compare english-text 1 "$inputs/english.txt"
compare english-json 1 --output json "$inputs/english.txt"
for output in text json; do
  if ! grep -qF "$(printf '\342\200\234events\342\200\235 \342\200\224 at the caf\303\251')" \
    "$tmp/$subject/english-$output.out" ||
    ! grep -qF "\\ud83d\\ude00 ev\\u200bents for d\\u0430ys \\u0023#[error] now." \
      "$tmp/$subject/english-$output.out" ||
    grep -qF '##' "$tmp/$subject/english-$output.out"; then
    echo "$check: case english-$output: the output doesn't keep and escape what it should" >&2
    exit 1
  fi
done
# An OpenSpec spec whose id is a GitHub Actions workflow command: its finding's line, which
# starts with the id, starts with the colon escaped.
printf '%s\n' '{"id": "::error::forged", "requirements": [{"name": "Upcoming",' \
  ' "text": "The scheduler lists upcoming events."}]}' >"$inputs/command-id.json"
compare command-id 1 "$inputs/command-id.json"
if ! grep -q '^\\u003a:error::forged/' "$tmp/$subject/command-id.out"; then
  echo "$check: case command-id: the line doesn't start with the colon escaped" >&2
  exit 1
fi
compare missing 2 "$inputs/missing.txt"
# A missing file whose name holds a right-to-left override, as its UTF-8 bytes: every build's
# message shows it as \u202e. So does its error log entry, whose details differ by platform.
# Only where an argument reaches every build as UTF-8: not under Git Bash on Windows, where the
# JVM decodes arguments with the code page, and not in a locale whose charset isn't UTF-8.
if [ "$(locale charmap 2>/dev/null)" = UTF-8 ] && ! uname -s | grep -q -E '^(MINGW|MSYS|CYGWIN)'
then
  compare missing-bidirectional 2 "$inputs/mis$(printf '\342\200\256')sing.txt"
  for who in "$subject" jvm; do
    for stream in err log; do
      if ! grep -qF "mis\\u202esing.txt" "$tmp/$who/missing-bidirectional.$stream" ||
        LC_ALL=C grep -q "$(printf '\342\200\256')" "$tmp/$who/missing-bidirectional.$stream"
      then
        echo "$check: case missing-bidirectional: $who's $stream doesn't show RLO as \\u202e" >&2
        exit 1
      fi
    done
  done
else
  echo "$check: missing-bidirectional: skipped, since arguments here may not reach the CLI as UTF-8"
fi
# A missing file whose name holds a GitHub Actions command marker: no build's message or log
# line holds two number signs side by side.
compare missing-command 2 "$inputs/##[add-mask]notes.txt"
for who in "$subject" jvm; do
  for stream in err log; do
    if grep -qF '##' "$tmp/$who/missing-command.$stream" ||
      ! grep -qF '[add-mask]notes.txt' "$tmp/$who/missing-command.$stream"; then
      echo "$check: case missing-command: $who's $stream holds ## or lacks the name" >&2
      exit 1
    fi
  done
done
compare directory 2 "$inputs/notes"
if [ "$(id -u)" -ne 0 ]; then
  compare unreadable 2 "$inputs/secret.txt"
else
  echo "$check: unreadable: skipped, since root can read any file"
fi
compare help 0 --help
# --help anywhere among the options; with an input file, invalid (so a glob that picks up a file
# named --help fails); after --, a file name.
compare help-after-option 0 --output json --help
compare help-with-file 2 --help "$inputs/plain.txt"
compare help-after-dashes 2 -- --help
compare bad-arguments 2 --format yaml
compare empty-file-name 2 "$inputs/plain.txt" ""
compare verbose 0 --verbose "$inputs/passing.txt"
# The comparison strips log lines, so a build ignoring --verbose would match: its log must have a
# debug line, which only --verbose writes.
if ! grep -q -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z DEBUG ' "$tmp/$subject/verbose.log"; then
  echo "$check: case verbose: $label's log has no DEBUG line" >&2
  exit 1
fi
# Non-ASCII output under the C locale, whose charset is ASCII: both write UTF-8 regardless (the
# JVM's own streams would write é as ?). In a subshell, so the locale applies to this case only.
printf 'When an order is placed the caf\303\251 shall print a receipt.\n' >"$inputs/accents.txt"
(
  export LC_ALL=C LANG=C
  compare c-locale 1 "$inputs/accents.txt"
)
printf '%s\n' 'The scheduler shall list upcoming events.' 'The scheduler lists events.' \
  >"$inputs/piped.txt"
stdin="$inputs/piped.txt"
compare standard-input 1
# The input size limit, at 1000 bytes: a file and standard input of exactly 1000 bytes are checked
# (the last line, cut short, may have a finding), and of 1001 bytes are too large; invalid limits
# reject the arguments. Built from a 1008-byte file with head, so no pipeline is cut short.
awk 'BEGIN { for (i = 0; i < 24; i++) print "The scheduler shall list upcoming events." }' \
  >"$inputs/requirements.txt"
head -c 1000 "$inputs/requirements.txt" >"$inputs/at-limit.txt"
head -c 1001 "$inputs/requirements.txt" >"$inputs/over-limit.txt"
compare file-at-limit "0 1" --max-input-bytes 1000 "$inputs/at-limit.txt"
compare file-over-limit 2 --max-input-bytes 1000 "$inputs/over-limit.txt"
if ! grep -qF 'more than 1000 bytes; --max-input-bytes raises the limit' \
  "$tmp/$subject/file-over-limit.err"; then
  echo "$check: case file-over-limit: the message doesn't give the limit" >&2
  exit 1
fi
stdin="$inputs/at-limit.txt"
compare standard-input-at-limit "0 1" --max-input-bytes 1000
stdin="$inputs/over-limit.txt"
compare standard-input-over-limit 2 --max-input-bytes 1000
compare limit-zero 2 --max-input-bytes 0 "$inputs/at-limit.txt"
compare limit-too-large 2 --max-input-bytes 104857601 "$inputs/at-limit.txt"
compare limit-with-unit 2 --max-input-bytes 10M "$inputs/at-limit.txt"
# A standard input that never ends: every build stops at the limit, with status 2 and the same
# message, rather than reading until memory runs out. Outside `compare`, which pipes a file.
for who in "$subject" jvm; do
  status=0
  yes | "${who}_cli" --max-input-bytes 1000 >"$tmp/$who/endless.out" 2>"$tmp/$who/endless.log" ||
    status=$?
  if [ "$status" -ne 2 ] ||
    ! grep -qF 'Cannot read standard input: more than 1000 bytes' "$tmp/$who/endless.log"; then
    echo "$check: case endless-standard-input: $who exited with $status" >&2
    cat "$tmp/$who/endless.log" >&2
    exit 1
  fi
done
echo "$check: endless-standard-input: the same (exit status 2)"
