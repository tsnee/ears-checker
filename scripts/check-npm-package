#!/usr/bin/env sh
# The npm package's smoke check: build @tsnee/ears-checker, lint the packed package with publint
# and Are the Types Wrong, install it into an empty project, and use it from TypeScript: type-check
# ears/npm/smoke/consumer.ts under Node and bundler module resolution, then run it on Node.
# Needs node, npm, jq, tsc, publint, and attw on the PATH; CI installs pinned versions.
#
# --out <dir> keeps the tarball it checked in <dir>, for a release to attach: copied before the
# tools run, and checked unchanged at the end.
set -e

usage() {
  echo "Usage: check-npm-package [--out <dir>]" >&2
  exit 2
}
out=
while [ $# -gt 0 ]; do
  case $1 in
    --out)
      [ $# -ge 2 ] || usage
      out=$2
      shift 2
      ;;
    *) usage ;;
  esac
done
case $out in
  "" | /*) ;;
  *) out=$(pwd)/$out ;;
esac

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi |
    cut -d ' ' -f 1
}

cd "$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
root=$(pwd)

# Mill runs on its own (not in a pipeline) so a failed build stops the script with Mill's errors.
if ! built=$(./mill --ticker false show ears.npm.npmPackage); then
  echo "check-npm-package: building the npm package failed (see the Mill output above)" >&2
  exit 1
fi
package=$(printf '%s' "$built" | jq -r 'sub("^ref:v[0-9]+:[0-9a-f]+:"; "")')
if [ -z "$package" ] || [ ! -f "$package/package.json" ]; then
  echo "check-npm-package: Mill printed no usable package directory: $built" >&2
  exit 1
fi

# Every npm command uses a cache in the temporary directory: nothing is written to ~/.npm, and
# nothing from it is reused.
tmp=$(mktemp -d)
# sh runs the EXIT trap on exit, but not when interrupted; the INT and TERM traps exit, which
# runs it.
trap 'rm -rf "$tmp"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
cache="$tmp/cache"

npm pack "$package" --pack-destination "$tmp" --cache "$cache" --silent >/dev/null
set -- "$tmp"/tsnee-ears-checker-*.tgz
tarball=$1
if [ ! -f "$tarball" ]; then
  echo "check-npm-package: npm pack wrote no tarball" >&2
  exit 1
fi
echo "check-npm-package: checking $(basename "$tarball"), sha256 $(sha256 "$tarball")"

# With --out, the tarball is kept now, before the tools below run, and checked unchanged at the
# end.
if [ -n "$out" ]; then
  mkdir -p "$out"
  kept="$out/$(basename "$tarball")"
  cp "$tarball" "$kept"
  kept_sha=$(sha256 "$kept")
  echo "check-npm-package: kept $kept, sha256 $kept_sha"
fi

# No file may name a path on this machine, such as a source map entry the build failed to make
# relative.
if tar -xOzf "$tarball" | grep -q -F -e "$root" -e "$HOME"; then
  echo "check-npm-package: the package names a path on this machine ($root or $HOME)" >&2
  exit 1
fi

unpacked="$tmp/unpacked"
mkdir "$unpacked"
tar -xzf "$tarball" -C "$unpacked"

# The code within its size limit: minified, main.js is about 608 KB; unminified, 1.57 MB. Raise
# the limit only on purpose, saying why in the commit.
limit=700000
size=$(wc -c <"$unpacked/package/main.js" | tr -d ' ')
if [ "$size" -gt "$limit" ]; then
  echo "check-npm-package: main.js is $size bytes, over the limit of $limit" >&2
  exit 1
fi

# The source map leads from the shipped code to the Scala sources: the start of the function
# exported as classify maps into Facade.scala. JavaScript, because Node's own source-map reader
# is the authority on what a debugger sees; Scala would have to decode the mappings by hand.
if ! node --input-type=module -e '
  import { readFileSync } from "node:fs";
  import { SourceMap } from "node:module";
  const dir = process.argv[1];
  const code = readFileSync(`${dir}/main.js`, "utf8");
  const name = code.match(/export\s*\{\s*([\w$]+) as classify\s*\}/)?.[1];
  const escaped = name?.replace(/\$/g, "\\$");
  const found = escaped && new RegExp(`let ${escaped}\\s*=\\s*\\(?(function)`, "d").exec(code);
  if (!found) {
    console.error("no definition of the function exported as classify");
    process.exit(1);
  }
  const at = found.indices[1][0];
  const line = code.slice(0, at).split("\n").length - 1;
  const column = at - (code.lastIndexOf("\n", at - 1) + 1);
  const map = new SourceMap(JSON.parse(readFileSync(`${dir}/main.js.map`, "utf8")));
  const source = map.findEntry(line, column).originalSource ?? "nothing";
  if (!source.endsWith("/Facade.scala")) {
    console.error(`classify maps to ${source}`);
    process.exit(1);
  }
' "$unpacked/package"; then
  echo "check-npm-package: the source map doesn't lead classify back to Facade.scala" >&2
  exit 1
fi

publint run "$tarball" --strict
# An ESM-only package can't be loaded by require(), by design; the profile leaves that out.
attw "$tarball" --profile esm-only

# An empty ES-module project with only the packed package installed. It has no dependencies to
# pin (checked below), and no install scripts run, as in every install here.
project="$tmp/consumer"
mkdir "$project"
printf '{"name": "consumer", "private": true, "type": "module"}\n' >"$project/package.json"
(cd "$project" &&
  npm install "$tarball" --ignore-scripts --cache "$cache" --no-audit --no-fund --silent)

# Every installed package, at any depth: `npm ls --all --parseable` prints the project's own
# directory first, then one line per package. The package must be the only one.
installed=$(cd "$project" && npm ls --all --parseable --cache "$cache" | sed 1d)
count=$(printf '%s\n' "$installed" | grep -c .) || true
case "$count:$installed" in
  "1:"*/node_modules/@tsnee/ears-checker) ;;
  *)
    echo "check-npm-package: installing the package installed: $installed" >&2
    exit 1
    ;;
esac
declared=$(jq -c '[.dependencies, .peerDependencies, .optionalDependencies,
  .bundleDependencies, .bundledDependencies] | map(select(. != null))' \
  "$project/node_modules/@tsnee/ears-checker/package.json")
if [ "$declared" != '[]' ]; then
  echo "check-npm-package: the package declares dependencies: $declared" >&2
  exit 1
fi

cp "$root/ears/npm/smoke/consumer.ts" "$project/consumer.ts"
cd "$project"
# --verbatimModuleSyntax and --erasableSyntaxOnly reject what Node's type stripping can't run,
# such as a type imported without `import type`.
typecheck() {
  if ! tsc --noEmit --strict --verbatimModuleSyntax --erasableSyntaxOnly \
    --exactOptionalPropertyTypes --noUncheckedIndexedAccess --target es2022 \
    --module "$1" --moduleResolution "$2" consumer.ts; then
    echo "check-npm-package: consumer.ts doesn't type-check with --moduleResolution $2" >&2
    exit 1
  fi
}
typecheck nodenext nodenext
typecheck esnext bundler
node consumer.ts
if [ -n "$out" ] && [ "$(sha256 "$kept")" != "$kept_sha" ]; then
  echo "check-npm-package: $kept changed while the check ran: sha256 $kept_sha, now" \
    "$(sha256 "$kept")" >&2
  exit 1
fi
echo "check-npm-package: the npm package builds, lints, installs, type-checks, and runs"
