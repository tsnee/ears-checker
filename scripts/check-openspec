#!/usr/bin/env sh
# The repository's OpenSpec gate: strict validation (warnings count as failures), then EARS
# checking of every requirement in every active change and every spec.
# Run by the Claude Code hook (scripts/claude-openspec-hook).
set -e

cd "$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"

openspec validate --all --strict --no-interactive
openspec validate --archived --strict --no-interactive

# Get the checker's jar. Mill rebuilds it only when code under ears/ changed since the last run.
# Mill runs on its own (not in a pipeline) so a failed build stops the script with Mill's errors
# instead of every check failing on an empty jar path.
if ! built=$(./mill --ticker false show ears.cli.assembly); then
  echo "check-openspec: building the EARS checker failed (see the Mill output above)" >&2
  exit 1
fi
jar=$(printf '%s' "$built" | jq -r 'sub("^ref:v[0-9]+:[0-9a-f]+:"; "")')
if [ -z "$jar" ] || [ ! -f "$jar" ]; then
  echo "check-openspec: Mill printed no usable assembly path: $built" >&2
  exit 1
fi

ears_check() {
  # Scala 3's runtime uses sun.misc.Unsafe, which JDK 27 warns about on every start.
  java --sun-misc-unsafe-memory-access=allow -jar "$jar" --format openspec "$@"
}

# Save every active change and every spec as OpenSpec JSON, then check them all in one checker
# run (one JVM start). The positional parameters collect the files in order: changes, then specs.
# A file that `openspec show` failed to write is left out, since the checker stops at the first
# input it can't parse and would hide every other finding.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# `openspec show` reports its errors as JSON on standard output, which went into the file.
show_failed() {
  echo "check-openspec: openspec show $1 failed, so its requirements were not EARS-checked:" >&2
  cat "$2" >&2
}

status=0
set --
for change in $(openspec list --json | jq -r '.changes[].name'); do
  file="$tmp/change-$change.json"
  if openspec show "$change" --type change --json --deltas-only > "$file"; then
    set -- "$@" "$file"
  else
    show_failed "change $change" "$file"
    status=1
  fi
done
for spec in $(openspec list --specs --json | jq -r '.specs[].id'); do
  file="$tmp/spec-$spec.json"
  if openspec show "$spec" --type spec --json > "$file"; then
    set -- "$@" "$file"
  else
    show_failed "spec $spec" "$file"
    status=1
  fi
done
# With no files the checker would wait on standard input.
if [ "$#" -gt 0 ]; then
  ears_check "$@" || status=1
fi

if [ "$status" -eq 0 ]; then
  echo "EARS: every requirement passes."
fi
exit "$status"
