#!/usr/bin/env sh
# The native CLI's check: build the native binary and the JVM jar, check that the binary links no
# cmark (it loads cmark when it runs), then run both on the cases in scripts/cli-cases and require
# the same standard output, the same messages on standard error (log lines aside), and the same
# exit status. A development check, run by contributors and CI.
# Needs java, jq, git, openspec, and cmark (to read Markdown) on the PATH; otool on macOS, ldd on
# Linux.
#
# --binary <file> and --jar <file> check a binary and jar built elsewhere instead of building
# them, such as a binary built on another runner of its platform; --out <dir> keeps the binary
# it checked and the jar it compared it with in <dir>, as ears-check and ears-check.jar, for
# another check or a release.
set -e

usage() {
  echo "Usage: check-native-cli [--binary <file>] [--jar <file>] [--out <dir>]" >&2
  exit 2
}
binary='' jar='' out=''
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || usage
  case $1 in
    --binary) binary=$2 ;;
    --jar) jar=$2 ;;
    --out) out=$2 ;;
    *) usage ;;
  esac
  shift 2
done
# Absolute, since the check runs from the repository's root.
absolute() {
  case $1 in
    "" | /*) printf '%s' "$1" ;;
    *) printf '%s/%s' "$(pwd)" "$1" ;;
  esac
}
binary=$(absolute "$binary") jar=$(absolute "$jar") out=$(absolute "$out")

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi |
    cut -d ' ' -f 1
}

cd "$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
root=$(pwd)

# Mill runs on its own (not in a pipeline) so a failed build stops the script with Mill's errors.
built() {
  if ! shown=$(./mill --ticker false show "$1"); then
    echo "check-native-cli: building $1 failed (see the Mill output above)" >&2
    exit 1
  fi
  printf '%s' "$shown" | jq -r 'if type == "object" then .path else . end |
    sub("^ref:v[0-9]+:[0-9a-f]+:"; "")'
}
if [ -z "$binary" ]; then
  binary=$(built ears.cli.native.nativeLink)
fi
if [ ! -f "$binary" ] || [ ! -x "$binary" ]; then
  echo "check-native-cli: no executable binary at $binary" >&2
  exit 1
fi
if [ -z "$jar" ]; then
  jar=$(built ears.cli.assembly)
fi
if [ -z "$jar" ] || [ ! -f "$jar" ]; then
  echo "check-native-cli: no jar at $jar" >&2
  exit 1
fi
echo "check-native-cli: checking $binary, sha256 $(sha256 "$binary")"
echo "check-native-cli: against $jar, sha256 $(sha256 "$jar")"

# Only the platform's system libraries are linked; cmark is found when the binary runs.
if [ "$(uname -s)" = Darwin ]; then
  linked=$(otool -L "$binary" | sed 1d)
else
  linked=$(ldd "$binary")
fi
if printf '%s\n' "$linked" | grep -q -i cmark; then
  echo "check-native-cli: the binary links cmark, which it should load when it runs:" >&2
  printf '%s\n' "$linked" >&2
  exit 1
fi

tmp=$(mktemp -d)
# sh runs the EXIT trap on exit, but not when interrupted; the INT and TERM traps exit, which
# runs it.
trap 'rm -rf "$tmp"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

native_cli() { "$binary" "$@"; }

check=check-native-cli subject=native label="the native CLI"
. "$root/scripts/cli-cases"
if [ -n "$out" ]; then
  mkdir -p "$out"
  cp "$binary" "$out/ears-check"
  cp "$jar" "$out/ears-check.jar"
  for kept in "$out/ears-check" "$out/ears-check.jar"; do
    echo "check-native-cli: kept $kept, sha256 $(sha256 "$kept")"
  done
fi
echo "check-native-cli: the native CLI matches the JVM CLI on every case"
