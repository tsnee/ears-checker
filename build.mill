/** WartRemover 3.6.3's Unsafe set without `Any`, which ZIO's `ZIO[Any, E, A]` environment trips. */
val zioSafeWarts = Seq(
  "AsInstanceOf",
  "DefaultArguments",
  "EitherProjectionPartial",
  "IsInstanceOf",
  "IterableOps",
  "NonUnitStatements",
  "Null",
  "OptionPartial",
  "Product",
  "Return",
  "Serializable",
  "StringPlusAny",
  "Throw",
  "TripleQuestionMark",
  "TryPartial",
  "Var"
)

/** The full Unsafe set, for code with no ZIO in it. */
val pureWarts = zioSafeWarts :+ "Any"

/** Versions shared by the JVM and Scala.js builds, so they can't drift apart. */
val zioVersion = "2.1.27"
val declineVersion = "2.6.2"
val zioJsonVersion = "1.1.1"

/** commonmark-java, for the release-notes tool. */
val commonmarkVersion = "0.31.0"

/** Chicory, which runs the Markdown parser's WebAssembly module on the JVM; the build-time compiler
  * in the header is the same release.
  */
val chicoryVersion = "1.7.5"

/** cmark-gfm's release, vendored in `ears/markdown/cmark-gfm` by `scripts/update-cmark-gfm`: the
  * four numbers its version header is generated from, as its CMake build generates it.
  */
val cmarkGfmVersion = (0, 29, 0, 13)

