//| mill-version: 1.3.1
//| mill-jvm-version: 27
//| mill-jvm-index-version: 0.0.5
package build

import mill.*
import mill.scalajslib.*
import mill.scalalib.*
import mill.scalalib.publish.*
import mill.scalalib.scalafmt.ScalafmtModule

/** WartRemover 3.6.3's Unsafe set without `Any`, which ZIO's `ZIO[Any, E, A]` environment trips. */
val zioSafeWarts = Seq(
  "AsInstanceOf",
  "DefaultArguments",
  "EitherProjectionPartial",
  "IsInstanceOf",
  "IterableOps",
  "NonUnitStatements",
  "Null",
  "OptionPartial",
  "Product",
  "Return",
  "Serializable",
  "StringPlusAny",
  "Throw",
  "TripleQuestionMark",
  "TryPartial",
  "Var"
)

/** The full Unsafe set, for code with no ZIO in it. */
val pureWarts = zioSafeWarts :+ "Any"

def wartOptions(warts: Seq[String]): Seq[String] =
  warts.map(w => s"-P:wartremover:traverser:org.wartremover.warts.$w")

/** Shared settings: Scala 3.10 targeting Java 17, warnings as errors, strict equality, explicit
  * nulls, and WartRemover warts as errors.
  */
trait Base extends ScalaModule with ScalafmtModule {
  def scalaVersion = "3.10.0"

  def warts: Seq[String] = zioSafeWarts

  def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-unchecked",
    // Scala 3.10's standard library needs Java 17, so compile against that API, not the JDK's.
    "-release:17",
    "-source:future",
    "-Wunused:all",
    "-Wvalue-discard",
    "-Wnonunit-statement",
    "-Wsafe-init",
    "-Wimplausible-patterns",
    "-Wrecurse-with-default",
    "-Winfer-union",
    "-Wshadow:all",
    "-Werror",
    "-Yexplicit-nulls",
    "-Ycheck-all-patmat",
    "-language:strictEquality"
  ) ++ wartOptions(warts)

  def scalacPluginMvnDeps = Seq(mvn"org.wartremover:::wartremover:3.6.3")
}

/** zio-test suites, on the JVM or Scala.js. Specs are ZIO values, so the Any wart is dropped. */
trait ZioSpecs extends ScalaModule with ScalafmtModule with TestModule.ZioTest {
  def scalacOptions = Task {
    super.scalacOptions().filterNot(wartOptions(Seq("Any")).contains)
  }

  def mvnDeps = Seq(
    mvn"dev.zio::zio-test::2.1.27",
    mvn"dev.zio::zio-test-sbt::2.1.27"
  )
}

/** Maven coordinates and POM metadata shared by every published module. */
trait Published extends PublishModule {
  def publishVersion = "0.1.0-SNAPSHOT"

  /** The POM's one-line description of this artifact. */
  def pomDescription: String

  def pomSettings = PomSettings(
    description = pomDescription,
    organization = "io.github.tsnee",
    url = "https://github.com/tsnee/ears-checker",
    licenses = Seq(License.`CC0-1.0`),
    versionControl = VersionControl.github("tsnee", "ears-checker"),
    developers = Seq(Developer("tsnee", "Tom Snee", "https://github.com/tsnee"))
  )
}

/** EARS requirement classifier: pure, no ZIO, portable to Scala.js. */
object ears extends Base with Published {
  override def warts = pureWarts
  def artifactName = "ears-checker"
  def pomDescription = "Classifies requirement sentences against the EARS templates"

  def mvnDeps = Seq(mvn"org.typelevel::cats-parse::1.1.0")

  object test extends ScalaTests with ZioSpecs

  /** The same library and tests built with Scala.js and run on Node, to keep `ears` portable. */
  object js extends Base with ScalaJSModule with Published {
    def scalaJSVersion = "1.22.0"
    override def warts = pureWarts
    def artifactName = ears.artifactName()
    def pomDescription = ears.pomDescription
    def sources = ears.sources
    def mvnDeps = ears.mvnDeps

    object test extends ScalaJSTests with ZioSpecs {
      def sources = ears.test.sources
    }
  }

  /** Command-line checker over plain text, Markdown, and OpenSpec JSON. */
  object cli extends Base with Published {
    def artifactName = "ears-checker-cli"
    def pomDescription = "EARS checker for plain text, Markdown, and OpenSpec JSON"
    def moduleDeps = Seq(ears)
    def mainClass = Some("io.github.tsnee.ears.cli.Main")

    def mvnDeps = Seq(
      mvn"dev.zio::zio:2.1.27",
      mvn"com.monovore::decline:2.6.2",
      mvn"dev.zio::zio-json:1.1.1",
      mvn"org.commonmark:commonmark:0.31.0"
    )

    object test extends ScalaTests with ZioSpecs {
      // Tests run in a sandbox directory; this lets them find the repo's OpenSpec files.
      def forkEnv = Task {
        super.forkEnv() ++
          Map("OPENSPEC_DIR" -> (mill.api.BuildCtx.workspaceRoot / "openspec").toString)
      }
    }
  }
}
