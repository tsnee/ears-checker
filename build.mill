/** The SHA-256 of the Markdown parser's WebAssembly module, which every build host must produce
  * from this repository's sources. A change to the C entry point, the vendored source, the
  * toolchain, or the flags changes it: the build fails, naming both checksums, until it's updated.
  */
val cmarkGfmWasmSha256 = "3b97183d9df3313b3f83e42f3e26540c5e4bf056f170fa729b5f19788d15209f"

/** The functions whose JVM methods, as Chicory's build-time compiler generates them, may exceed
  * HotSpot's 8,000-byte compile limit (`DontCompileHugeMethods`), so stay in the JVM's bytecode
  * interpreter: none is on the path that parses ordinary Markdown. `_scan_autolink_email` serves
  * only the autolink extension, which isn't used; `_scan_html_block_start` runs only for lines
  * starting with `<`; `printf_core` only for cmark-gfm's error messages and footnotes, which aren't
  * used (the entry point writes its numbers without it, since it was most of the JVM's time).
  */
val cmarkGfmHugeFunctions = Set("_scan_autolink_email", "printf_core", "_scan_html_block_start")

/** HotSpot's default `HugeMethodLimit`, in bytes of bytecode. */
val hugeMethodLimit = 8000

/** The wasi-sdk archive for a build host, given its Java `os.name` and `os.arch`. */
def wasiSdkArchive(osName: String, arch: String): Either[String, String] = {
  val system = osName.toLowerCase match {
    case name if name.startsWith("mac")     => Right("macos")
    case name if name.startsWith("linux")   => Right("linux")
    case name if name.startsWith("windows") => Right("windows")
    case _ => Left(s"wasi-sdk publishes no archive for the operating system $osName")
  }
  val processor = arch match {
    case "aarch64" | "arm64" => Right("arm64")
    case "x86_64" | "amd64"  => Right("x86_64")
    case _ => Left(s"wasi-sdk publishes no archive for the processor $arch")
  }
  for (s <- system; p <- processor)
    yield s"wasi-sdk-${wasiSdkTag.stripPrefix("wasi-sdk-")}.0-$p-$s.tar.gz"
}

/** A file's SHA-256, in lowercase hex. */
def sha256(path: os.Path): String =
  java.security.MessageDigest
    .getInstance("SHA-256")
    .digest(os.read.bytes(path))
    .map(b => f"${b & 0xff}%02x")
    .mkString

/** Nothing when `actual` is the recorded checksum; otherwise the failure, naming both. */
def checksumMatches(what: String, actual: String, recorded: String): Either[String, Unit] =
  Either.cond(
    actual == recorded,
    (),
    s"$what has SHA-256 $actual, but build.mill records $recorded"
  )

/** The size of each method's bytecode in a class file, by name, read from its `Code` attribute
  * with ASM's constant-pool reader (ASM itself gives no method's size).
  */
def methodCodeSizes(classFile: Array[Byte]): Seq[(String, Int)] = {
  val reader = new org.objectweb.asm.ClassReader(classFile)
  val buffer = new Array[Char](reader.getMaxStringLength)
  def u2(at: Int) = reader.readUnsignedShort(at)
  def u4(at: Int) = reader.readInt(at)
  // Skips a field's or method's attributes, from their count: the offset after them.
  def afterAttributes(at: Int): Int =
    (0 until u2(at)).foldLeft(at + 2)((offset, _) => offset + 6 + u4(offset + 2))
  val afterInterfaces = reader.header + 8 + 2 * u2(reader.header + 6)
  val afterFields =
    (0 until u2(afterInterfaces)).foldLeft(afterInterfaces + 2)((offset, _) =>
      afterAttributes(offset + 6)
    )
  (0 until u2(afterFields))
    .foldLeft((afterFields + 2, Seq.empty[(String, Int)])) { case ((offset, sizes), _) =>
      val name = reader.readUTF8(offset + 2, buffer)
      val attributes = offset + 6
      val code = (0 until u2(attributes))
        .foldLeft((attributes + 2, Option.empty[Int])) { case ((at, found), _) =>
          val size = if (reader.readUTF8(at, buffer) == "Code") Some(u4(at + 10)) else None
          (at + 6 + u4(at + 2), found.orElse(size))
        }
        ._2
      (afterAttributes(attributes), sizes ++ code.map(name -> _))
    }
    ._2
}

def wartOptions(warts: Seq[String]): Seq[String] =
  warts.map(w => s"-P:wartremover:traverser:org.wartremover.warts.$w")

/** A Scala.js source map for an npm package, with `sourcesContent` for every source from this
  * repository: a path relative to the repository root, or, in a release, its tagged URL on
  * GitHub. Library sources keep their public `https://` URLs and no content. Content is read only
  * from under `roots`, the linked modules' source directories (Mill allows a task to read only
  * declared sources). Anything else fails the build rather than ship a map with a gap or a
  * machine's path: a `file:` URI, such as a library built on someone's machine names its sources
  * by, an absolute path (a Scala.js module without `SourceUris`), or a relative path outside
  * `roots`.
  */
def embedProjectSources(
    map: os.Path,
    release: String,
    roots: Seq[os.Path]
): Either[String, ujson.Value] = {
  val json = ujson.read(os.read(map))
  def unrecognized(uri: String) =
    Left(s"Source map names $uri, an unrecognized source URI: neither a library's https URL " +
      "nor one of the package's own sources")
  val contents = json("sources").arr.toSeq.map { source =>
    val uri = source.str
    val path =
      if (uri.startsWith(release)) uri.stripPrefix(release)
      else uri
    if (path.startsWith("https://")) Right(ujson.Null) // a library's public source
    else
      scala.util.Try(os.RelPath(path)).toOption // no scheme, not absolute
        .filter(_ => !path.contains(":"))
        .map(mill.api.BuildCtx.workspaceRoot / _)
        .filter(file => roots.exists(file.startsWith) && os.isFile(file))
        .fold[Either[String, ujson.Value]](unrecognized(uri))(file =>
          Right(ujson.Str(os.read(file)))
        )
  }
  contents.collectFirst { case Left(message) => message }.toLeft {
    json("sourcesContent") = ujson.Arr(contents.collect { case Right(content) => content }*)
    json
  }
}

/** The linked `main.js` in `linked`, minified by `esbuild` into `dest/out`: Scala.js minifies only
  * in a Scala-specific way, meant to be followed by a general-purpose minifier. With `withMap`,
  * esbuild reads the linker's `main.js.map` and writes one for the minified code, naming the same
  * sources; this repository's come back relative to the repository root, as the linker named
  * them. Fails on any esbuild error or warning, with esbuild's output; a clean run has none.
  */
def minify(
    esbuild: os.Path,
    linked: os.Path,
    dest: os.Path,
    withMap: Boolean
): Either[String, os.Path] = {
  val (in, out) = (dest / "in", dest / "out")
  os.remove.all(dest)
  os.makeDir.all(in)
  os.copy.into(linked / "main.js", in)
  if (withMap) os.copy.into(linked / "main.js.map", in)
  // Node 22 is the oldest Node either package declares.
  val command = Seq(esbuild.toString, "in/main.js", "--minify", "--format=esm", "--target=node22",
    "--outfile=out/main.js", "--log-level=warning") ++ (if (withMap) Seq("--sourcemap") else Nil)
  val result = os.proc(command).call(cwd = dest, check = false, stdout = os.Pipe, stderr = os.Pipe,
    mergeErrIntoOut = true)
  val log = result.out.text().trim
  if (result.exitCode != 0 || log.nonEmpty)
    Left(s"esbuild ${command.drop(1).mkString(" ")} (in $dest) exited ${result.exitCode}: $log")
  else {
    if (withMap) {
      // esbuild names the input's relative sources from the output: ../in/ears/src/... .
      val map = ujson.read(os.read(out / "main.js.map"))
      val sources = map("sources").arr.toSeq.map(s => ujson.Str(s.str.stripPrefix("../in/")))
      map("sources") = ujson.Arr(sources*)
      os.write.over(out / "main.js.map", ujson.write(map))
    }
    Right(out)
  }
}

/** Shared settings: Scala 3.10 targeting Java 17, warnings as errors, strict equality, explicit
  * nulls, and WartRemover warts as errors.
  */
trait Base extends ScalaModule with ScalafmtModule {
  def scalaVersion = "3.10.0"

  def warts: Seq[String] = zioSafeWarts

  def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-unchecked",
    // Scala 3.10's standard library needs Java 17, so compile against that API, not the JDK's.
    "-release:17",
    "-source:future",
    "-Wunused:all",
    "-Wvalue-discard",
    "-Wnonunit-statement",
    "-Wsafe-init",
    "-Wimplausible-patterns",
    "-Wrecurse-with-default",
    "-Winfer-union",
    "-Wshadow:all",
    "-Werror",
    "-Yexplicit-nulls",
    "-Ycheck-all-patmat",
    "-language:strictEquality"
  ) ++ wartOptions(warts)

  def scalacPluginMvnDeps = Seq(mvn"org.wartremover:::wartremover:3.6.3")
}

/** zio-test suites, on the JVM or Scala.js. Specs are ZIO values, so the Any wart is dropped. */
trait ZioSpecs extends ScalaModule with ScalafmtModule with TestModule.ZioTest {
  def scalacOptions = Task {
    super.scalacOptions().filterNot(wartOptions(Seq("Any")).contains)
  }

  // Added to what the test module already has: Scala Native's test modules bring their test
  // interface this way.
  def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"dev.zio::zio-test::$zioVersion",
    mvn"dev.zio::zio-test-sbt::$zioVersion"
  )
}

/** Statement and branch coverage, measured whenever a `ScoverageTests` module's tests run. They run
  * against an instrumented copy of the module (`<module>.scoverage`); the module's own jars, and
  * so every published artifact, come from the ordinary classes.
  */
trait Covered extends ScoverageModule {
  def scoverageVersion = "2.5.2"

  /** Tests that measure only their own run. The plugin's data directory is persistent, so without
    * this each run's measurement files pile up beside the last and coverage can only rise locally.
    */
  trait CoveredTests extends ScoverageTests {

    /** Clears the measurements in the args task, which Mill evaluates before the tests run. */
    override protected def testTask(args: Task[Seq[String]], globSelectors: Task[Seq[String]]) =
      super.testTask(
        Task.Anon {
          os.list(scoverage.data().path)
            .filter(_.last.startsWith("scoverage.measurements."))
            .foreach(os.remove)
          args()
        },
        globSelectors
      )
  }
}

/** Scala.js IR records each source file's URI for source maps. A release points them at the
  * tagged sources on GitHub; any other build makes them relative to the repository root, so no
  * machine's paths end up in a jar or the npm package.
  */
trait SourceUris extends ScalaJSModule {
  def scalacOptions = Task {
    val root = mill.api.BuildCtx.workspaceRoot.toNIO.toUri.toString
    val target = ears.publishVersion() match {
      case v if v.endsWith("-SNAPSHOT") => ""
      case v => s"->${ears.releaseSourceUrl(v)}"
    }
    super.scalacOptions() :+ s"-scalajs-mapSourceURI:$root$target"
  }
}

/** npm packages pinned by the module's `package.json` and `package-lock.json`, installed with
  * `npm ci`. No install scripts run, so no downloaded code runs at install time. The cache is in
  * the task's own directory, so nothing is written to `~/.npm`.
  */
trait NpmInstalled extends Module {

  /** `package.json` and `package-lock.json`. */
  def npmManifest = Task.Sources("package.json", "package-lock.json")

  /** The installed `node_modules`. */
  def npmDependencies = Task {
    npmManifest().foreach(file => os.copy.into(file.path, Task.dest))
    os.proc(
      "npm", "ci", "--ignore-scripts", "--cache", (Task.dest / "cache").toString, "--no-audit",
      "--no-fund", "--loglevel=error"
    ).call(cwd = Task.dest, stdout = os.Inherit, stderr = os.Inherit)
    PathRef(Task.dest / "node_modules")
  }
}

/** Maven coordinates and POM metadata shared by every published module. */
trait Published extends PublishModule {

  /** The release workflow sets EARS_RELEASE_VERSION from the tag; every other build is a snapshot.
    * An input, so the environment is read on every run and a cached version can't carry over.
    * Anything but <major>.<minor>.<patch> fails, so a stray value can't publish a release version
    * (to ~/.ivy2/local, say); an empty value counts as unset.
    */
  def publishVersion = Task.Input {
    Task.env.get("EARS_RELEASE_VERSION").filter(_.nonEmpty) match {
      case None => "0.3.0-SNAPSHOT"
      case Some(v) if v.matches("""\d+\.\d+\.\d+""") => v
      case Some(v) =>
        Task.fail(s"EARS_RELEASE_VERSION must be <major>.<minor>.<patch>, not '$v'")
    }
  }

  /** The POM's one-line description of this artifact. */
  def pomDescription: String

  def pomSettings = PomSettings(
    description = pomDescription,
    organization = "io.github.tsnee",
    url = "https://github.com/tsnee/ears-checker",
    licenses = Seq(License.`CC0-1.0`),
    versionControl = VersionControl.github("tsnee", "ears-checker"),
    developers = Seq(Developer("tsnee", "Tom Snee", "https://github.com/tsnee"))
  )
}

/** EARS requirement classifier: pure, no ZIO, portable to Scala.js. */
object ears extends Base with Published with Covered {
  override def warts = pureWarts
  def artifactName = "ears-checker"
  def pomDescription = "Classifies requirement sentences against the EARS templates"

  def mvnDeps = Seq(mvn"org.typelevel::cats-parse::1.1.0")

  /** Sources for both platforms. `src-jvm` and `js/src` hold the few that differ by platform. */
  def sharedSources = Task.Sources("src")
  def sources = Task(sharedSources() ++ jvmSources())
  def jvmSources = Task.Sources("src-jvm")

  /** Where a release's sources are on GitHub: the base for its source map URIs. */
  def releaseSourceUrl(version: String): String =
    s"https://raw.githubusercontent.com/tsnee/ears-checker/v$version/"

  def statementCoverageMin = Some(95.0)
  def branchCoverageMin = Some(90.0)

  object test extends CoveredTests with ZioSpecs

  /** The same library and tests built with Scala.js and run on Node, to keep `ears` portable. */
  object js extends Base with ScalaJSModule with Published with SourceUris {
    def scalaJSVersion = "1.22.0"
    override def warts = pureWarts
    def artifactName = ears.artifactName()
    def pomDescription = ears.pomDescription
    def sources = Task(ears.sharedSources() ++ super.sources())
    def mvnDeps = ears.mvnDeps

    object test extends ScalaJSTests with ZioSpecs {
      def sources = ears.test.sources
    }
  }

  /** The same sources and tests on Scala Native, for the native CLI. `ears/src-jvm` serves it
    * too: Scala Native's `java.util.Locale` gives `LetterCase` the JVM's results. Not published.
    */
  object native extends Base with ScalaNativeModule {
    def scalaNativeVersion = markdown.native.scalaNativeVersion()
    override def warts = pureWarts
    def sources = Task(ears.sharedSources() ++ ears.jvmSources())
    def mvnDeps = ears.mvnDeps

    object test extends ScalaNativeTests with ZioSpecs {
      def sources = ears.test.sources
    }
  }

  /** The npm package `@tsnee/ears-checker`. This module is its pure core, every decision behind
    * `classify`, compiled and measured on the JVM; `js` adds the Scala.js export. Neither is
    * published to Maven Central: top-level exports in a Scala.js library would be exported from
    * every application that depends on it.
    */
  object npm extends Base with Covered {
    override def warts = pureWarts
    def moduleDeps = Seq(ears)

    def statementCoverageMin = Some(100.0)
    def branchCoverageMin = Some(100.0)

    object test extends CoveredTests with ZioSpecs {
      def moduleDeps = super.moduleDeps ++ Seq(ears.test)
    }

    /** The core's sources and the export, linked as an ES module. */
    object js extends Base with ScalaJSModule with SourceUris {
      def scalaJSVersion = ears.js.scalaJSVersion()
      override def warts = pureWarts
      def moduleDeps = Seq(ears.js)
      def sources = Task(super.sources() ++ npm.sources())
      def moduleKind = Task(ModuleKind.ESModule)

      object test extends ScalaJSTests with ZioSpecs {
        def moduleDeps = super.moduleDeps ++ Seq(ears.js.test)
      }
    }

    /** Build tools for both npm packages: esbuild, which minifies them. */
    object tools extends NpmInstalled {

      /** The esbuild executable. */
      def esbuild = Task(PathRef(npmDependencies().path / ".bin" / "esbuild"))
    }

    /** The hand-written package files: `index.d.ts` and `README.md`. */
    def packageFiles = Task.Source("package")

    def license = Task.Source(mill.api.BuildCtx.workspaceRoot / "LICENSE")

    /** The release version, or the next version with npm's `-dev` in place of `-SNAPSHOT`. */
    def npmVersion = Task {
      ears.publishVersion().stripSuffix("-SNAPSHOT") + {
        if (ears.publishVersion().endsWith("-SNAPSHOT")) "-dev" else ""
      }
    }

    /** The linked library minified, with a source map (see `minify`). */
    def minified = Task {
      minify(tools.esbuild().path, js.fullLinkJS().dest.path, Task.dest, withMap = true) match {
        case Right(out) => PathRef(out)
        case Left(message) => Task.fail(message)
      }
    }

    /** The npm package `@tsnee/ears-checker`, ready for `npm pack`: the minified ES module, its
      * source map with this repository's sources embedded, the declarations, README, license,
      * and a generated `package.json`.
      */
    def npmPackage = Task {
      val linked = minified().path
      val out = Task.dest
      os.copy(linked / "main.js", out / "main.js")
      embedProjectSources(
        linked / "main.js.map",
        ears.releaseSourceUrl(ears.publishVersion()),
        (ears.js.sources() ++ js.sources()).map(_.path)
      ) match {
        case Right(map) => os.write(out / "main.js.map", ujson.write(map))
        case Left(message) => Task.fail(message)
      }
      os.copy(packageFiles().path / "index.d.ts", out / "index.d.ts")
      os.copy(packageFiles().path / "README.md", out / "README.md")
      os.copy(license().path, out / "LICENSE")
      val repository = "https://github.com/tsnee/ears-checker"
      val manifest = ujson.Obj(
        "name" -> "@tsnee/ears-checker",
        "version" -> npmVersion(),
        "description" -> ears.pomDescription,
        "keywords" -> ujson.Arr("ears", "requirements", "requirements-engineering", "lint"),
        "homepage" -> s"$repository#readme",
        "bugs" -> ujson.Obj("url" -> s"$repository/issues"),
        "repository" -> ujson.Obj("type" -> "git", "url" -> s"git+$repository.git"),
        "license" -> "CC0-1.0",
        "type" -> "module",
        "exports" -> ujson.Obj(
          "." -> ujson.Obj("types" -> "./index.d.ts", "default" -> "./main.js"),
          "./package.json" -> "./package.json"
        ),
        "types" -> "./index.d.ts",
        "files" -> ujson.Arr("main.js", "main.js.map", "index.d.ts"),
        "sideEffects" -> false,
        "engines" -> ujson.Obj("node" -> ">=22")
      )
      os.write(out / "package.json", ujson.write(manifest, indent = 2) + "\n")
      PathRef(out)
    }
  }

  /** Requirement sentences from Markdown, read with cmark-gfm on every platform (`parser`): shared
    * code reads its tree, and each platform calls it its own way (Chicory here; Node's
    * `WebAssembly` in `js`; compiled in, in `native`). Not published: `cli` compiles the shared and
    * JVM sources into itself.
    */
  object markdown extends Base with Covered {
    override def warts = pureWarts
    def sharedSources = Task.Sources("src")
    def jvmSources = Task.Sources("src-jvm")
    def sources = Task(sharedSources() ++ jvmSources())
    def mvnDeps = Seq(mvn"com.dylibso.chicory:runtime:$chicoryVersion")

    // The parser's JVM classes: resources, so they're on every runtime classpath and in the jar,
    // and compile resources, so the JVM code compiles against them.
    def resources = Task(super.resources() :+ parser.jvmClasses())
    def compileResources = Task(super.compileResources() :+ parser.jvmClasses())

    def statementCoverageMin = Some(100.0)
    def branchCoverageMin = Some(100.0)

    /** cmark-gfm, built into the checker: its vendored source and the C entry point
      * (`ears/markdown/c`), compiled into a WebAssembly module with a pinned wasi-sdk for the JVM
      * (through Chicory, compiled to JVM classes here) and Node, and given to Scala Native as C
      * source.
      */
    object parser extends Module {
      def cmarkGfm = Task.Source(markdown.moduleDir / "cmark-gfm")
      def entryPoint = Task.Source(markdown.moduleDir / "c")

      /** The three headers cmark-gfm's CMake build generates: `config.h` from its template, with
        * everything it tests for present; `cmark-gfm_version.h`; and `cmark-gfm_export.h`,
        * exporting nothing, since nothing links it as a shared library.
        */
      def headers = Task {
        val src = cmarkGfm().path / "src"
        val config = os
          .read(src / "config.h.in")
          .replace("#cmakedefine HAVE_STDBOOL_H", "#define HAVE_STDBOOL_H")
          .replace("#cmakedefine HAVE___BUILTIN_EXPECT", "#define HAVE___BUILTIN_EXPECT")
          .replace("#cmakedefine HAVE___ATTRIBUTE__", "#define HAVE___ATTRIBUTE__")
        val (major, minor, patch, gfm) = cmarkGfmVersion
        val version = os
          .read(src / "cmark-gfm_version.h.in")
          .replace("@PROJECT_VERSION_MAJOR@", major.toString)
          .replace("@PROJECT_VERSION_MINOR@", minor.toString)
          .replace("@PROJECT_VERSION_PATCH@", patch.toString)
          .replace("@PROJECT_VERSION_GFM@", gfm.toString)
        os.write(Task.dest / "config.h", config)
        os.write(Task.dest / "cmark-gfm_version.h", version)
        os.write(
          Task.dest / "cmark-gfm_export.h",
          "#ifndef CMARK_GFM_EXPORT_H\n#define CMARK_GFM_EXPORT_H\n#define CMARK_GFM_EXPORT\n#endif\n"
        )
        PathRef(Task.dest)
      }

      /** The wasi-sdk archive this host builds with and its recorded SHA-256, as one name, without
        * downloading anything: CI's cache key for `~/.cache/ears-checker/wasi-sdk`.
        */
      def wasiSdkKey = Task {
        val key = for {
          name <- wasiSdkArchive(sys.props("os.name"), sys.props("os.arch"))
          recorded <- wasiSdkArchives.get(name).toRight(s"build.mill records no checksum for $name")
        } yield s"$name-$recorded"
        key.fold(Task.fail(_), identity)
      }

      /** The wasi-sdk archive for this host, downloaded once into `~/.cache/ears-checker` (which
        * CI caches) and checked against its recorded SHA-256 before anything is extracted from
        * it, then extracted here: the toolchain's directory.
        */
      def wasiSdk = Task {
        val sdk = for {
          name <- wasiSdkArchive(sys.props("os.name"), sys.props("os.arch"))
          recorded <- wasiSdkArchives.get(name).toRight(s"build.mill records no checksum for $name")
          archive = os.home / ".cache" / "ears-checker" / "wasi-sdk" / name
          _ = if (!os.exists(archive)) {
            val url = s"https://github.com/WebAssembly/wasi-sdk/releases/download/$wasiSdkTag/$name"
            Task.log.info(s"Downloading $url")
            val client = java.net.http.HttpClient
              .newBuilder()
              .followRedirects(java.net.http.HttpClient.Redirect.NORMAL)
              .build()
            val partial = archive / os.up / s"$name.part"
            os.makeDir.all(archive / os.up)
            val response = client.send(
              java.net.http.HttpRequest.newBuilder(java.net.URI.create(url)).build(),
              java.net.http.HttpResponse.BodyHandlers.ofFile(partial.toNIO)
            )
            if (response.statusCode == 200) os.move(partial, archive, replaceExisting = true)
            else Task.fail(s"Downloading $url gave HTTP status ${response.statusCode}")
          }
          actual = sha256(archive)
          _ <- checksumMatches(name, actual, recorded).left.map { message =>
            os.remove(archive)
            s"$message; removed the archive, so the next build downloads it again"
          }
        } yield archive
        sdk match {
          case Left(message) => Task.fail(message)
          case Right(archive) =>
            os.proc("tar", "-xzf", archive, "-C", Task.dest).call(stderr = os.Pipe)
            os.list(Task.dest).filter(os.isDir) match {
              case Seq(top) => PathRef(top)
              case _        => Task.fail(s"$archive doesn't hold one top directory")
            }
        }
      }

      /** The WebAssembly module, checked against `cmarkGfmWasmSha256`, and the same module with
        * its function names (`named`), for the method-size check's messages. `-DNDEBUG` drops
        * cmark-gfm's assertions, as its CMake release build does, and with them the build's file
        * paths; clang's `PATH` holds only the toolchain, so no `wasm-opt` on the host's path runs
        * after linking. `-fno-inline-functions` keeps the hot functions small enough for HotSpot to
        * compile on the JVM.
        */
      def wasm = Task {
        val sdk = wasiSdk().path
        val bin = sdk / "bin"
        val source = cmarkGfm().path
        val entry = entryPoint().path
        val common = Seq(
          "--target=wasm32-wasip1",
          s"--sysroot=${sdk / "share" / "wasi-sysroot"}",
          "-O2",
          "-fno-inline-functions",
          "-DNDEBUG",
          s"-ffile-prefix-map=$source=cmark-gfm",
          s"-ffile-prefix-map=$entry=c",
          "-I",
          headers().path.toString,
          "-I",
          (source / "src").toString,
          "-I",
          (source / "extensions").toString
        )
        val env = Map("PATH" -> bin.toString)
        val entryObject = Task.dest / "ears_cmark.o"
        os.proc(
          bin / "clang",
          common,
          "-Wall",
          "-Wextra",
          "-Werror",
          "-c",
          entry / "ears_cmark.c",
          "-o",
          entryObject
        ).call(env = env, stderr = os.Pipe)
        val sources = (os.list(source / "src") ++ os.list(source / "extensions"))
          .filter(file => file.ext == "c" && file.last != "main.c")
          .sortBy(_.last)
        val named = Task.dest / "cmark-gfm-named.wasm"
        os.proc(
          bin / "clang",
          common,
          "-w",
          "-mexec-model=reactor",
          sources,
          entryObject,
          "-o",
          named,
          "-Wl,--export=ears_alloc,--export=ears_free,--export=ears_tree,--export=ears_version"
        ).call(env = env, stderr = os.Pipe)
        val module = Task.dest / "cmark-gfm.wasm"
        os.proc(bin / "llvm-objcopy", "--strip-all", named, module).call(env = env, stderr = os.Pipe)
        checksumMatches("The built cmark-gfm.wasm", sha256(module), cmarkGfmWasmSha256) match {
          case Left(message) => Task.fail(message)
          case Right(())     => PathRef(Task.dest)
        }
      }

      /** The module compiled to JVM classes by Chicory's build-time compiler, with its `.meta`
        * module, as a class directory; it fails if a generated method of a function not in
        * `cmarkGfmHugeFunctions` exceeds HotSpot's compile limit, naming each.
        */
      def jvmClasses = Task {
        val module = wasm().path
        val classes = Task.dest / "classes"
        val generator = new com.dylibso.chicory.build.time.compiler.Generator(
          com.dylibso.chicory.build.time.compiler.Config
            .builder()
            .withWasmFile((module / "cmark-gfm.wasm").toNIO)
            .withName("io.github.tsnee.ears.markdown.CmarkGfmModule")
            .withTargetClassFolder(classes.toNIO)
            .withTargetSourceFolder((Task.dest / "unused-sources").toNIO)
            .withTargetWasmFolder(classes.toNIO)
            .withInterpreterFallback(com.dylibso.chicory.compiler.InterpreterFallback.SILENT)
            .build()
        )
        generator.generateMetaWasm(generator.generateResources())
        val names = com.dylibso.chicory.wasm.Parser
          .parse((module / "cmark-gfm-named.wasm").toNIO)
          .nameSection()
        val function = "func_(\\d+)".r
        val huge = os
          .walk(classes)
          .filter(_.ext == "class")
          .flatMap(file => methodCodeSizes(os.read.bytes(file)))
          .collect {
            case (function(index), size) if size > hugeMethodLimit =>
              (names.nameOfFunction(index.toInt), size)
          }
        huge.filterNot((name, _) => cmarkGfmHugeFunctions(name)) match {
          case Seq() => PathRef(classes)
          case over =>
            Task.fail(
              s"Chicory compiled ${over.map((name, size) => s"$name ($size bytes)").mkString(", ")} " +
                s"to JVM methods over $hugeMethodLimit bytes of bytecode, which HotSpot won't " +
                "compile; build.mill allows only " + cmarkGfmHugeFunctions.toSeq.sorted.mkString(", ")
            )
        }
      }

      /** cmark-gfm's license notices, `COPYING`, where the CLI jar carries them:
        * `META-INF/cmark-gfm/COPYING`, as a resource directory.
        */
      def jvmNotices = Task {
        os.copy(
          cmarkGfm().path / "COPYING",
          Task.dest / "META-INF" / "cmark-gfm" / "COPYING",
          createFolders = true
        )
        PathRef(Task.dest)
      }

      /** The GitHub Release's `THIRD-PARTY-NOTICES.txt`: a heading naming cmark-gfm's release and
        * where it's compiled in, then its `COPYING`, unchanged.
        */
      def thirdPartyNotices = Task {
        val (major, minor, patch, gfm) = cmarkGfmVersion
        val heading =
          s"""Third-party notices for ears-check
             |
             |ears-check reads Markdown with cmark-gfm $major.$minor.$patch.gfm.$gfm
             |(https://github.com/github/cmark-gfm), compiled into the jar, the npm package
             |@tsnee/ears-checker-cli, and the native binaries. Its license notices, its COPYING
             |file, follow unchanged.
             |
             |""".stripMargin
        val out = Task.dest / "THIRD-PARTY-NOTICES.txt"
        os.write(out, heading + os.read(cmarkGfm().path / "COPYING"))
        PathRef(out)
      }

      /** The module's recorded SHA-256, for the scripts that check a package holding it. */
      def wasmSha256 = Task(cmarkGfmWasmSha256)

      def nodeLoader = Task.Source(markdown.moduleDir / "js" / "cmark-gfm-wasm.mjs")

      /** The module for Node: `cmark-gfm-wasm.mjs`, which reads it from beside itself, and the
        * module, in one directory.
        */
      def nodeModule = Task {
        os.copy.into(nodeLoader().path, Task.dest)
        os.copy.into(wasm().path / "cmark-gfm.wasm", Task.dest)
        PathRef(Task.dest)
      }

      /** The C source for Scala Native:cmark-gfm's (but its command line's `main.c`), the
        * generated headers, and the entry point, in one `scala-native` directory, which Scala
        * Native compiles into the binary when it's a compile resource. Each of cmark-gfm's `.c`
        * files starts with `NDEBUG` defined, as the WebAssembly build compiles it (its assertions,
        * which would carry the build's paths into the binary, compiled out), and a `#line` that
        * keeps its own lines and name; the vendored files are unchanged.
        */
      def nativeSources = Task {
        val out = Task.dest / "scala-native"
        os.makeDir.all(out)
        val source = cmarkGfm().path
        (os.list(source / "src") ++ os.list(source / "extensions"))
          .filter(file => Set("c", "h", "inc")(file.ext) && file.last != "main.c")
          .foreach { file =>
            if (file.ext == "c")
              os.write(out / file.last, s"#define NDEBUG 1\n#line 1 \"${file.last}\"\n${os.read(file)}")
            else os.copy.into(file, out)
          }
        os.list(headers().path).foreach(os.copy.into(_, out))
        os.copy.into(entryPoint().path / "ears_cmark.c", out)
        PathRef(Task.dest)
      }

      /** The C compiler options cmark-gfm needs on Scala Native: its extensions include its headers
        * with angle brackets, so its directory goes on the include path.
        */
      def nativeIncludes = Task(Seq("-I", (nativeSources().path / "scala-native").toString))
    }

    /** The conformance suite, which every platform's test module compiles. */
    object test extends CoveredTests with ZioSpecs {

      /** The suites shared with `js.test` and `native.test`; `src-jvm` has those that need the
        * JVM.
        */
      def sharedSources = Task.Sources("src")
      def jvmSources = Task.Sources("src-jvm")
      def sources = Task(sharedSources() ++ jvmSources())
    }

    /** The shared sources and the call of cmark-gfm's WebAssembly module, for Node. Its tests run
      * the conformance suite.
      */
    object js extends Base with ScalaJSModule {
      def scalaJSVersion = ears.js.scalaJSVersion()
      override def warts = pureWarts
      def sources = Task(markdown.sharedSources() ++ super.sources())
      def moduleKind = Task(ModuleKind.ESModule)

      object test extends ScalaJSTests with ZioSpecs {
        def sources = markdown.test.sharedSources

        // Node resolves a bare import only from `node_modules` above the importing file, and the
        // tests are linked under `out/`: the map points the import at cmark-gfm's module.
        def scalaJSImportMap = Task {
          val cmarkGfm = parser.nodeModule().path / "cmark-gfm-wasm.mjs"
          Seq(ESModuleImportMapping.Prefix("cmark-gfm-wasm", cmarkGfm.toNIO.toUri.toString))
        }
      }
    }

    /** The shared sources and the call of cmark-gfm, compiled into the binary from its C source,
      * for Scala Native. Its tests run the conformance suite natively.
      */
    object native extends Base with ScalaNativeModule {
      def scalaNativeVersion = "0.5.12"
      override def warts = pureWarts
      def sources = Task(markdown.sharedSources() ++ super.sources())
      // cmark-gfm's C source and the entry point, which Scala Native compiles into the binary.
      def compileResources = Task(super.compileResources() :+ parser.nativeSources())
      def nativeCompileOptions = Task(super.nativeCompileOptions() ++ parser.nativeIncludes())

      object test extends ScalaNativeTests with ZioSpecs {
        def sources = markdown.test.sharedSources
        def nativeCompileOptions = Task(super.nativeCompileOptions() ++ parser.nativeIncludes())
      }
    }
  }

  /** Command-line checker over plain text, Markdown, and OpenSpec JSON. */
  object cli extends Base with Published with Covered {
    def artifactName = "ears-checker-cli"
    def pomDescription = "EARS checker for plain text, Markdown, and OpenSpec JSON"
    def moduleDeps = Seq(ears)
    def mainClass = Some("io.github.tsnee.ears.cli.Main")

    /** The program, shared with `js`; `src-jvm` has the JVM's entry point and reading. */
    def sharedSources = Task.Sources("src")
    def jvmSources = Task.Sources("src-jvm")

    // The Markdown facade's shared and JVM sources, compiled in rather than depended on, so the
    // published POM names no unpublished artifact.
    def sources = Task(
      sharedSources() ++ jvmSources() ++ markdown.sharedSources() ++ markdown.jvmSources()
    )

    // `markdown` measures those sources itself, with its conformance suite; here they'd count as
    // CLI code that the CLI's tests needn't reach. Scala 3's coverage ignores the option outside
    // an instrumented compile.
    def scalacOptions =
      Task(super.scalacOptions() :+ "-coverage-exclude-files:.*/ears/markdown/.*")

    def mvnDeps = Seq(
      mvn"dev.zio::zio:$zioVersion",
      mvn"com.monovore::decline:$declineVersion",
      mvn"dev.zio::zio-json:$zioJsonVersion",
      mvn"com.dylibso.chicory:runtime:$chicoryVersion"
    )

    // The Markdown parser's JVM classes, as `markdown` has them (its sources are compiled in), and
    // cmark-gfm's notices.
    def resources = Task(
      super.resources() :+ markdown.parser.jvmClasses() :+ markdown.parser.jvmNotices()
    )
    def compileResources = Task(super.compileResources() :+ markdown.parser.jvmClasses())

    def statementCoverageMin = Some(96.0)
    def branchCoverageMin = Some(95.0)

    /** `CheckerBuild.version`, the release this program is (`publishVersion`: `0.2.0`, or the next
      * version as `0.3.0-SNAPSHOT`), which JSON output names. Not `BuildInfo`: zio-json has one, and
      * a wildcard import of `zio.json.*` would take its place. Generated for every platform's build
      * of the program, so they all say the same.
      */
    def checkerBuild = Task {
      os.write(
        Task.dest / "io" / "github" / "tsnee" / "ears" / "cli" / "CheckerBuild.scala",
        s"""package io.github.tsnee.ears.cli
           |
           |/** Generated by build.mill (`cli.checkerBuild`). */
           |private[cli] object CheckerBuild:
           |  val version: String = "${publishVersion()}"
           |""".stripMargin,
        createFolders = true
      )
      PathRef(Task.dest)
    }
    def generatedSources = Task(super.generatedSources() :+ checkerBuild())

    object test extends CoveredTests with ZioSpecs {

      /** The suites shared with `js.test`; `src-jvm` has those that need the JVM. */
      def sharedSources = Task.Sources("src")
      def jvmSources = Task.Sources("src-jvm")
      def sources = Task(sharedSources() ++ jvmSources())

      // `OwnSpecsSuite` reads the specs with commonmark-java, apart from the CLI's own reader.
      def mvnDeps = Task(super.mvnDeps() :+ mvn"org.commonmark:commonmark:$commonmarkVersion")

      // Tests run in a sandbox directory; this lets them find the repo's OpenSpec files, and
      // cmark-gfm's notices to compare with the jar's.
      def forkEnv = Task {
        super.forkEnv() ++
          Map(
            "OPENSPEC_DIR" -> (mill.api.BuildCtx.workspaceRoot / "openspec").toString,
            "CMARK_GFM_DIR" -> markdown.parser.cmarkGfm().path.toString
          )
      }
    }

    /** The same program as a native binary: the shared sources, the JVM's entry point and
      * reading (`src-jvm`: every Java API it uses works on Scala Native), and the Markdown
      * facade, with cmark-gfm compiled in. Linked with Scala Native's full release optimizations; its tests,
      * which only need to run, in debug mode, which links much faster.
      */
    object native extends Base with ScalaNativeModule {
      def scalaNativeVersion = markdown.native.scalaNativeVersion()
      def moduleDeps = Seq(ears.native)
      // markdown.native's sources include the facade's shared ones.
      def sources = Task(cli.sharedSources() ++ cli.jvmSources() ++ markdown.native.sources())
      def compileResources = Task(super.compileResources() :+ markdown.parser.nativeSources())
      def generatedSources = Task(super.generatedSources() :+ cli.checkerBuild())
      def mainClass = Some("io.github.tsnee.ears.cli.Main")
      def releaseMode = Task(ReleaseMode.ReleaseFull)

      // On macOS, the oldest release the binary runs on, the oldest GitHub's runners have;
      // otherwise clang declares the build machine's own release.
      private def macosMinimum =
        if (scala.util.Properties.isMac) Seq("-mmacosx-version-min=15.0") else Nil
      def nativeCompileOptions = Task(
        super.nativeCompileOptions() ++ macosMinimum ++ markdown.parser.nativeIncludes()
      )
      def nativeLinkingOptions = Task(super.nativeLinkingOptions() ++ macosMinimum)

      def mvnDeps = Seq(
        mvn"dev.zio::zio::$zioVersion",
        mvn"com.monovore::decline::$declineVersion",
        mvn"dev.zio::zio-json::$zioJsonVersion"
      )

      object test extends ScalaNativeTests with ZioSpecs {
        def sources = cli.test.sharedSources
        def releaseMode = Task(ReleaseMode.Debug)
        def nativeCompileOptions =
          Task(super.nativeCompileOptions() ++ markdown.parser.nativeIncludes())
      }
    }

    /** The same program on Node: the shared sources, Node's entry point and reading (`js/src`),
      * and the Markdown facade's Node parser. Not published to Maven; it becomes the npm package
      * `@tsnee/ears-checker-cli`.
      */
    object js extends Base with ScalaJSModule with SourceUris {
      def scalaJSVersion = ears.js.scalaJSVersion()
      def moduleDeps = Seq(ears.js)
      def sources = Task(cli.sharedSources() ++ super.sources() ++ markdown.js.sources())
      def generatedSources = Task(super.generatedSources() :+ cli.checkerBuild())
      def mainClass = Some("io.github.tsnee.ears.cli.NodeMain")

      // cmark-gfm's module is imported from beside main.js, where the package puts it (esbuild
      // minifies main.js but doesn't bundle its imports).
      def scalaJSImportMap = Task(
        Seq(ESModuleImportMapping.Prefix("cmark-gfm-wasm", "./cmark-gfm-wasm.mjs"))
      )
      def moduleKind = Task(ModuleKind.ESModule)

      // ZIO needs java.time on Scala.js but doesn't declare it; zio-test brings it into tests.
      def mvnDeps = Seq(
        mvn"dev.zio::zio::$zioVersion",
        mvn"com.monovore::decline::$declineVersion",
        mvn"dev.zio::zio-json::$zioJsonVersion",
        mvn"io.github.cquiroz::scala-java-time::2.9.0"
      )

      object test extends ScalaJSTests with ZioSpecs {
        def sources = cli.test.sharedSources
        def scalaJSImportMap = markdown.js.test.scalaJSImportMap
      }

      /** The hand-written package file: `README.md`. */
      def packageFiles = Task.Source("package")

      /** The linked CLI minified, without a source map (see `minify`): a command-line tool's
        * users don't debug into it.
        */
      def minified = Task {
        minify(npm.tools.esbuild().path, fullLinkJS().dest.path, Task.dest, withMap = false) match {
          case Right(out) => PathRef(out)
          case Left(message) => Task.fail(message)
        }
      }

      /** The npm package `@tsnee/ears-checker-cli`, ready for `npm pack`: the minified ES module,
        * cmark-gfm's WebAssembly module and the three-line module that reads it, cmark-gfm's
        * notices, the `ears-check` command, the README, license, and a generated `package.json`,
        * with no dependencies.
        */
      def npmPackage = Task {
        val out = Task.dest
        os.copy(minified().path / "main.js", out / "main.js")
        // The command is a two-line wrapper, so main.js stays exactly esbuild's output.
        os.write(
          out / "bin" / "ears-check.js",
          "#!/usr/bin/env node\nimport \"../main.js\";\n",
          perms = "rwxr-xr-x",
          createFolders = true
        )
        os.copy(packageFiles().path / "README.md", out / "README.md")
        os.copy(npm.license().path, out / "LICENSE")
        // The Markdown parser beside main.js, and its license notices.
        os.list(markdown.parser.nodeModule().path).foreach(os.copy.into(_, out))
        os.copy(
          markdown.parser.cmarkGfm().path / "COPYING",
          out / "cmark-gfm" / "COPYING",
          createFolders = true
        )
        val repository = "https://github.com/tsnee/ears-checker"
        val manifest = ujson.Obj(
          "name" -> "@tsnee/ears-checker-cli",
          "version" -> npm.npmVersion(),
          "description" -> cli.pomDescription,
          "keywords" -> ujson.Arr(
            "ears", "requirements", "requirements-engineering", "lint", "cli", "markdown",
            "openspec"
          ),
          "homepage" -> s"$repository#readme",
          "bugs" -> ujson.Obj("url" -> s"$repository/issues"),
          "repository" -> ujson.Obj("type" -> "git", "url" -> s"git+$repository.git"),
          "license" -> "CC0-1.0",
          "type" -> "module",
          "bin" -> ujson.Obj("ears-check" -> "./bin/ears-check.js"),
          "files" -> ujson.Arr(
            "main.js",
            "cmark-gfm-wasm.mjs",
            "cmark-gfm.wasm",
            "cmark-gfm/COPYING",
            "bin/ears-check.js"
          ),
          "engines" -> ujson.Obj("node" -> ">=22")
        )
        os.write(out / "package.json", ujson.write(manifest, indent = 2) + "\n")
        PathRef(out)
      }
    }
  }

  /** Writes a program that references every public operation of the library, from the library's
    * SemanticDB; `scripts/check-scalajs-link` links it against the published Scala.js artifact.
    * Not published.
    */
  object linkCheck extends Base with Covered {
    def mvnDeps = Seq(
      mvn"dev.zio::zio:$zioVersion",
      mvn"org.scalameta:semanticdb-shared_2.13:4.17.4"
    )

    def statementCoverageMin = Some(96.0)
    def branchCoverageMin = Some(100.0)

    object test extends CoveredTests with ZioSpecs {
      // The Scala.js library's SemanticDB (shared and Scala.js-only sources: what's published),
      // and the fixture's, for the tests that run the rules on real compiler output.
      def forkEnv = Task {
        super.forkEnv() ++ Map(
          "EARS_SEMANTICDB" -> ears.js.semanticDbData().path.toString,
          "FIXTURE_SEMANTICDB" -> fixture.semanticDbData().path.toString
        )
      }
    }

    /** Every operation shape the generator handles; `scripts/check-scalajs-link` compiles the
      * program generated from it. Not published.
      */
    object fixture extends Base
  }

  /** Checks `CHANGELOG.md`'s form and writes a version's release notes from its section. Reads
    * Markdown with commonmark-java directly: it needs headings and source text, which the
    * checker's facade doesn't give. Not published.
    */
  object releaseNotes extends Base with Covered {
    def mvnDeps = Seq(
      mvn"dev.zio::zio:$zioVersion",
      mvn"org.commonmark:commonmark:$commonmarkVersion"
    )

    def statementCoverageMin = Some(96.0)
    def branchCoverageMin = Some(100.0)

    object test extends CoveredTests with ZioSpecs
  }
}
