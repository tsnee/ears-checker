//| mill-version: 1.3.1
//| mill-jvm-version: 27
//| mill-jvm-index-version: 0.0.5
//| mvnDeps: ["com.lihaoyi::mill-contrib-scoverage:$MILL_VERSION"]
package build

import mill.*
import mill.contrib.scoverage.ScoverageModule
import mill.scalajslib.*
import mill.scalajslib.api.ESModuleImportMapping
import mill.scalajslib.api.ModuleKind
import mill.scalanativelib.*
import mill.scalalib.*
import mill.scalalib.publish.*
import mill.scalalib.scalafmt.ScalafmtModule

/** WartRemover 3.6.3's Unsafe set without `Any`, which ZIO's `ZIO[Any, E, A]` environment trips. */
val zioSafeWarts = Seq(
  "AsInstanceOf",
  "DefaultArguments",
  "EitherProjectionPartial",
  "IsInstanceOf",
  "IterableOps",
  "NonUnitStatements",
  "Null",
  "OptionPartial",
  "Product",
  "Return",
  "Serializable",
  "StringPlusAny",
  "Throw",
  "TripleQuestionMark",
  "TryPartial",
  "Var"
)

/** The full Unsafe set, for code with no ZIO in it. */
val pureWarts = zioSafeWarts :+ "Any"

/** Versions shared by the JVM and Scala.js builds, so they can't drift apart. */
val zioVersion = "2.1.27"
val declineVersion = "2.6.2"
val zioJsonVersion = "1.1.1"

def wartOptions(warts: Seq[String]): Seq[String] =
  warts.map(w => s"-P:wartremover:traverser:org.wartremover.warts.$w")

/** A Scala.js source map for an npm package, with `sourcesContent` for every source from this
  * repository: a path relative to the repository root, or, in a release, its tagged URL on
  * GitHub. Library sources keep their URIs and no content: a public `https://` URL, or a
  * `file:` URI from the machine that built the library (ZIO's, decline's, and others' are).
  * Content is read only from under `roots`, the linked modules' source directories (Mill allows
  * a task to read only declared sources). Anything else fails the build rather than ship a map
  * with a gap or a path from this machine: a `file:` URI in this repository or an absolute path
  * (a Scala.js module without `SourceUris`), or a relative path outside `roots`.
  */
def embedProjectSources(
    map: os.Path,
    release: String,
    roots: Seq[os.Path]
): Either[String, ujson.Value] = {
  val json = ujson.read(os.read(map))
  // A file: URI elsewhere: a library built on another machine. Parsed, not compared as text, so
  // another spelling of a path in this repository can't pass for one.
  def elsewhere(uri: String) =
    scala.util.Try(java.nio.file.Paths.get(java.net.URI(uri))).toOption
      .exists(file => !file.normalize.startsWith(mill.api.BuildCtx.workspaceRoot.toNIO))
  def unrecognized(uri: String) =
    Left(s"Source map names $uri, an unrecognized source URI: neither a library's https URL " +
      "nor one of the package's own sources")
  val contents = json("sources").arr.toSeq.map { source =>
    val uri = source.str
    val path =
      if (uri.startsWith(release)) uri.stripPrefix(release)
      else uri
    if (path.startsWith("https://")) Right(ujson.Null) // a library's public source
    else if (path.startsWith("file:") && elsewhere(path)) Right(ujson.Null)
    else
      scala.util.Try(os.RelPath(path)).toOption // no scheme, not absolute
        .filter(_ => !path.contains(":"))
        .map(mill.api.BuildCtx.workspaceRoot / _)
        .filter(file => roots.exists(file.startsWith) && os.isFile(file))
        .fold[Either[String, ujson.Value]](unrecognized(uri))(file =>
          Right(ujson.Str(os.read(file)))
        )
  }
  contents.collectFirst { case Left(message) => message }.toLeft {
    json("sourcesContent") = ujson.Arr(contents.collect { case Right(content) => content }*)
    json
  }
}

/** Shared settings: Scala 3.10 targeting Java 17, warnings as errors, strict equality, explicit
  * nulls, and WartRemover warts as errors.
  */
trait Base extends ScalaModule with ScalafmtModule {
  def scalaVersion = "3.10.0"

  def warts: Seq[String] = zioSafeWarts

  def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-unchecked",
    // Scala 3.10's standard library needs Java 17, so compile against that API, not the JDK's.
    "-release:17",
    "-source:future",
    "-Wunused:all",
    "-Wvalue-discard",
    "-Wnonunit-statement",
    "-Wsafe-init",
    "-Wimplausible-patterns",
    "-Wrecurse-with-default",
    "-Winfer-union",
    "-Wshadow:all",
    "-Werror",
    "-Yexplicit-nulls",
    "-Ycheck-all-patmat",
    "-language:strictEquality"
  ) ++ wartOptions(warts)

  def scalacPluginMvnDeps = Seq(mvn"org.wartremover:::wartremover:3.6.3")
}

/** zio-test suites, on the JVM or Scala.js. Specs are ZIO values, so the Any wart is dropped. */
trait ZioSpecs extends ScalaModule with ScalafmtModule with TestModule.ZioTest {
  def scalacOptions = Task {
    super.scalacOptions().filterNot(wartOptions(Seq("Any")).contains)
  }

  // Added to what the test module already has: Scala Native's test modules bring their test
  // interface this way.
  def mvnDeps = super.mvnDeps() ++ Seq(
    mvn"dev.zio::zio-test::$zioVersion",
    mvn"dev.zio::zio-test-sbt::$zioVersion"
  )
}

/** Statement and branch coverage, measured whenever a `ScoverageTests` module's tests run. They run
  * against an instrumented copy of the module (`<module>.scoverage`); the module's own jars, and
  * so every published artifact, come from the ordinary classes.
  */
trait Covered extends ScoverageModule {
  def scoverageVersion = "2.5.2"

  /** Tests that measure only their own run. The plugin's data directory is persistent, so without
    * this each run's measurement files pile up beside the last and coverage can only rise locally.
    */
  trait CoveredTests extends ScoverageTests {

    /** Clears the measurements in the args task, which Mill evaluates before the tests run. */
    override protected def testTask(args: Task[Seq[String]], globSelectors: Task[Seq[String]]) =
      super.testTask(
        Task.Anon {
          os.list(scoverage.data().path)
            .filter(_.last.startsWith("scoverage.measurements."))
            .foreach(os.remove)
          args()
        },
        globSelectors
      )
  }
}

/** Scala.js IR records each source file's URI for source maps. A release points them at the
  * tagged sources on GitHub; any other build makes them relative to the repository root, so no
  * machine's paths end up in a jar or the npm package.
  */
trait SourceUris extends ScalaJSModule {
  def scalacOptions = Task {
    val root = mill.api.BuildCtx.workspaceRoot.toNIO.toUri.toString
    val target = ears.publishVersion() match {
      case v if v.endsWith("-SNAPSHOT") => ""
      case v => s"->${ears.releaseSourceUrl(v)}"
    }
    super.scalacOptions() :+ s"-scalajs-mapSourceURI:$root$target"
  }
}

/** Maven coordinates and POM metadata shared by every published module. */
trait Published extends PublishModule {

  /** The release workflow sets EARS_RELEASE_VERSION from the tag; every other build is a snapshot.
    * An input, so the environment is read on every run and a cached version can't carry over.
    * Anything but <major>.<minor>.<patch> fails, so a stray value can't publish a release version
    * (to ~/.ivy2/local, say); an empty value counts as unset.
    */
  def publishVersion = Task.Input {
    Task.env.get("EARS_RELEASE_VERSION").filter(_.nonEmpty) match {
      case None => "0.2.0-SNAPSHOT"
      case Some(v) if v.matches("""\d+\.\d+\.\d+""") => v
      case Some(v) =>
        Task.fail(s"EARS_RELEASE_VERSION must be <major>.<minor>.<patch>, not '$v'")
    }
  }

  /** The POM's one-line description of this artifact. */
  def pomDescription: String

  def pomSettings = PomSettings(
    description = pomDescription,
    organization = "io.github.tsnee",
    url = "https://github.com/tsnee/ears-checker",
    licenses = Seq(License.`CC0-1.0`),
    versionControl = VersionControl.github("tsnee", "ears-checker"),
    developers = Seq(Developer("tsnee", "Tom Snee", "https://github.com/tsnee"))
  )
}

/** EARS requirement classifier: pure, no ZIO, portable to Scala.js. */
object ears extends Base with Published with Covered {
  override def warts = pureWarts
  def artifactName = "ears-checker"
  def pomDescription = "Classifies requirement sentences against the EARS templates"

  def mvnDeps = Seq(mvn"org.typelevel::cats-parse::1.1.0")

  /** Sources for both platforms. `src-jvm` and `js/src` hold the few that differ by platform. */
  def sharedSources = Task.Sources("src")
  def sources = Task(sharedSources() ++ jvmSources())
  def jvmSources = Task.Sources("src-jvm")

  /** Where a release's sources are on GitHub: the base for its source map URIs. */
  def releaseSourceUrl(version: String): String =
    s"https://raw.githubusercontent.com/tsnee/ears-checker/v$version/"

  def statementCoverageMin = Some(95.0)
  def branchCoverageMin = Some(90.0)

  object test extends CoveredTests with ZioSpecs

  /** The same library and tests built with Scala.js and run on Node, to keep `ears` portable. */
  object js extends Base with ScalaJSModule with Published with SourceUris {
    def scalaJSVersion = "1.22.0"
    override def warts = pureWarts
    def artifactName = ears.artifactName()
    def pomDescription = ears.pomDescription
    def sources = Task(ears.sharedSources() ++ super.sources())
    def mvnDeps = ears.mvnDeps

    object test extends ScalaJSTests with ZioSpecs {
      def sources = ears.test.sources
    }
  }

  /** The npm package `@tsnee/ears-checker`. This module is its pure core, every decision behind
    * `classify`, compiled and measured on the JVM; `js` adds the Scala.js export. Neither is
    * published to Maven Central: top-level exports in a Scala.js library would be exported from
    * every application that depends on it.
    */
  object npm extends Base with Covered {
    override def warts = pureWarts
    def moduleDeps = Seq(ears)

    def statementCoverageMin = Some(100.0)
    def branchCoverageMin = Some(100.0)

    object test extends CoveredTests with ZioSpecs {
      def moduleDeps = super.moduleDeps ++ Seq(ears.test)
    }

    /** The core's sources and the export, linked as an ES module. */
    object js extends Base with ScalaJSModule with SourceUris {
      def scalaJSVersion = ears.js.scalaJSVersion()
      override def warts = pureWarts
      def moduleDeps = Seq(ears.js)
      def sources = Task(super.sources() ++ npm.sources())
      def moduleKind = Task(ModuleKind.ESModule)

      object test extends ScalaJSTests with ZioSpecs {
        def moduleDeps = super.moduleDeps ++ Seq(ears.js.test)
      }
    }

    /** The hand-written package files: `index.d.ts` and `README.md`. */
    def packageFiles = Task.Source("package")

    def license = Task.Source(mill.api.BuildCtx.workspaceRoot / "LICENSE")

    /** The release version, or the next version with npm's `-dev` in place of `-SNAPSHOT`. */
    def npmVersion = Task {
      ears.publishVersion().stripSuffix("-SNAPSHOT") + {
        if (ears.publishVersion().endsWith("-SNAPSHOT")) "-dev" else ""
      }
    }

    /** The npm package `@tsnee/ears-checker`, ready for `npm pack`: the linked ES module, its
      * source map with this repository's sources embedded, the declarations, README, license,
      * and a generated `package.json`.
      */
    def npmPackage = Task {
      val linked = js.fullLinkJS().dest.path
      val out = Task.dest
      os.copy(linked / "main.js", out / "main.js")
      embedProjectSources(
        linked / "main.js.map",
        ears.releaseSourceUrl(ears.publishVersion()),
        (ears.js.sources() ++ js.sources()).map(_.path)
      ) match {
        case Right(map) => os.write(out / "main.js.map", ujson.write(map))
        case Left(message) => Task.fail(message)
      }
      os.copy(packageFiles().path / "index.d.ts", out / "index.d.ts")
      os.copy(packageFiles().path / "README.md", out / "README.md")
      os.copy(license().path, out / "LICENSE")
      val repository = "https://github.com/tsnee/ears-checker"
      val manifest = ujson.Obj(
        "name" -> "@tsnee/ears-checker",
        "version" -> npmVersion(),
        "description" -> ears.pomDescription,
        "keywords" -> ujson.Arr("ears", "requirements", "requirements-engineering", "lint"),
        "homepage" -> s"$repository#readme",
        "bugs" -> ujson.Obj("url" -> s"$repository/issues"),
        "repository" -> ujson.Obj("type" -> "git", "url" -> s"git+$repository.git"),
        "license" -> "CC0-1.0",
        "type" -> "module",
        "exports" -> ujson.Obj(
          "." -> ujson.Obj("types" -> "./index.d.ts", "default" -> "./main.js"),
          "./package.json" -> "./package.json"
        ),
        "types" -> "./index.d.ts",
        "files" -> ujson.Arr("main.js", "main.js.map", "index.d.ts"),
        "sideEffects" -> false,
        "engines" -> ujson.Obj("node" -> ">=22")
      )
      os.write(out / "package.json", ujson.write(manifest, indent = 2) + "\n")
      PathRef(out)
    }
  }

  /** Requirement sentences from Markdown: shared extraction over a small parser facade, with one
    * parser per platform (commonmark-java here; mdast on Node in `js`; cmark in `native`). Not
    * published: `cli` compiles the shared and JVM sources into itself.
    */
  object markdown extends Base with Covered {
    override def warts = pureWarts
    def sharedSources = Task.Sources("src")
    def jvmSources = Task.Sources("src-jvm")
    def sources = Task(sharedSources() ++ jvmSources())
    def mvnDeps = Seq(mvn"org.commonmark:commonmark:0.31.0")

    def statementCoverageMin = Some(100.0)
    def branchCoverageMin = Some(100.0)

    /** The conformance suite, which every platform's test module compiles. */
    object test extends CoveredTests with ZioSpecs

    /** The shared sources and the mdast parser, for Node. Its tests run the conformance suite. */
    object js extends Base with ScalaJSModule {
      def scalaJSVersion = ears.js.scalaJSVersion()
      override def warts = pureWarts
      def sources = Task(markdown.sharedSources() ++ super.sources())
      def moduleKind = Task(ModuleKind.ESModule)

      /** `package.json` and `package-lock.json`, which pin the npm parser. */
      def npmManifest = Task.Sources("package.json", "package-lock.json")

      /** The npm parser and its dependencies, installed with `npm ci` from the lockfile. The cache
        * is in the task's own directory, so nothing is written to `~/.npm`.
        */
      def npmDependencies = Task {
        npmManifest().foreach(file => os.copy.into(file.path, Task.dest))
        os.proc(
          "npm", "ci", "--cache", (Task.dest / "cache").toString, "--no-audit", "--no-fund",
          "--loglevel=error"
        ).call(cwd = Task.dest, stdout = os.Inherit, stderr = os.Inherit)
        PathRef(Task.dest / "node_modules")
      }

      object test extends ScalaJSTests with ZioSpecs {
        def sources = markdown.test.sources

        // Node resolves a bare import only from `node_modules` above the importing file, and the
        // tests are linked under `out/`: the map points the import at the installed package.
        def scalaJSImportMap = Task {
          val entry = npmDependencies().path / "mdast-util-from-markdown" / "index.js"
          Seq(ESModuleImportMapping.Prefix("mdast-util-from-markdown", entry.toNIO.toUri.toString))
        }
      }
    }

    /** The shared sources and the cmark parser, for Scala Native. Its tests run the conformance
      * suite natively, linked with the system's cmark.
      */
    object native extends Base with ScalaNativeModule {
      def scalaNativeVersion = "0.5.12"
      override def warts = pureWarts
      def sources = Task(markdown.sharedSources() ++ super.sources())

      /** cmark's linker flags, from `pkg-config`: read on every run (an input), so a change of
        * the system library is noticed.
        */
      def cmarkLinking = Task.Input {
        val missing = "cmark isn't installed, or pkg-config can't find it: install them " +
          "(`brew install cmark pkg-config`, or `apt-get install libcmark-dev pkg-config`) " +
          "to link ears.markdown.native"
        // os-lib throws when the program itself isn't there.
        scala.util.Try(os.proc("pkg-config", "--libs", "libcmark").call(check = false)).toOption
          .filter(_.exitCode == 0) match {
          case Some(found) => found.out.trim().split("\\s+").toSeq.filter(_.nonEmpty)
          case None => Task.fail(missing)
        }
      }

      // cmark's flags first, so its -L comes before Mill's defaults (such as Homebrew's lib
      // directory) and the library pkg-config names is the one linked.
      def nativeLinkingOptions = Task(cmarkLinking() ++ super.nativeLinkingOptions())

      object test extends ScalaNativeTests with ZioSpecs {
        def sources = markdown.test.sources
        def nativeLinkingOptions = Task(cmarkLinking() ++ super.nativeLinkingOptions())
      }
    }
  }

  /** Command-line checker over plain text, Markdown, and OpenSpec JSON. */
  object cli extends Base with Published with Covered {
    def artifactName = "ears-checker-cli"
    def pomDescription = "EARS checker for plain text, Markdown, and OpenSpec JSON"
    def moduleDeps = Seq(ears)
    def mainClass = Some("io.github.tsnee.ears.cli.Main")

    /** The program, shared with `js`; `src-jvm` has the JVM's entry point and reading. */
    def sharedSources = Task.Sources("src")
    def jvmSources = Task.Sources("src-jvm")

    // The Markdown facade's shared and JVM sources, compiled in rather than depended on, so the
    // published POM names no unpublished artifact.
    def sources = Task(
      sharedSources() ++ jvmSources() ++ markdown.sharedSources() ++ markdown.jvmSources()
    )

    // `markdown` measures those sources itself, with its conformance suite; here they'd count as
    // CLI code that the CLI's tests needn't reach. Scala 3's coverage ignores the option outside
    // an instrumented compile.
    def scalacOptions =
      Task(super.scalacOptions() :+ "-coverage-exclude-files:.*/ears/markdown/.*")

    def mvnDeps = Seq(
      mvn"dev.zio::zio:$zioVersion",
      mvn"com.monovore::decline:$declineVersion",
      mvn"dev.zio::zio-json:$zioJsonVersion",
      mvn"org.commonmark:commonmark:0.31.0"
    )

    def statementCoverageMin = Some(96.0)
    def branchCoverageMin = Some(95.0)

    object test extends CoveredTests with ZioSpecs {

      /** The suites shared with `js.test`; `src-jvm` has those that need the JVM. */
      def sharedSources = Task.Sources("src")
      def jvmSources = Task.Sources("src-jvm")
      def sources = Task(sharedSources() ++ jvmSources())

      // Tests run in a sandbox directory; this lets them find the repo's OpenSpec files.
      def forkEnv = Task {
        super.forkEnv() ++
          Map("OPENSPEC_DIR" -> (mill.api.BuildCtx.workspaceRoot / "openspec").toString)
      }
    }

    /** The same program on Node: the shared sources, Node's entry point and reading (`js/src`),
      * and the Markdown facade's Node parser. Not published to Maven; it becomes the npm package
      * `@tsnee/ears-checker-cli`.
      */
    object js extends Base with ScalaJSModule with SourceUris {
      def scalaJSVersion = ears.js.scalaJSVersion()
      def moduleDeps = Seq(ears.js)
      def sources = Task(cli.sharedSources() ++ super.sources() ++ markdown.js.sources())
      def mainClass = Some("io.github.tsnee.ears.cli.NodeMain")
      def moduleKind = Task(ModuleKind.ESModule)

      // ZIO needs java.time on Scala.js but doesn't declare it; zio-test brings it into tests.
      def mvnDeps = Seq(
        mvn"dev.zio::zio::$zioVersion",
        mvn"com.monovore::decline::$declineVersion",
        mvn"dev.zio::zio-json::$zioJsonVersion",
        mvn"io.github.cquiroz::scala-java-time::2.9.0"
      )

      object test extends ScalaJSTests with ZioSpecs {
        def sources = cli.test.sharedSources
        def scalaJSImportMap = markdown.js.test.scalaJSImportMap
      }

      /** The hand-written package file: `README.md`. */
      def packageFiles = Task.Source("package")

      /** The npm package `@tsnee/ears-checker-cli`, ready for `npm pack`: the linked ES module, its
        * source map with this repository's sources embedded, the `ears-check` command, the README,
        * license, and a generated `package.json`. It depends on exactly the Markdown parser the
        * facade's conformance suite runs on Node, read from that suite's lockfile.
        */
      def npmPackage = Task {
        val linked = fullLinkJS().dest.path
        val out = Task.dest
        os.copy(linked / "main.js", out / "main.js")
        embedProjectSources(
          linked / "main.js.map",
          ears.releaseSourceUrl(ears.publishVersion()),
          (ears.js.sources() ++ sources()).map(_.path)
        ) match {
          case Right(map) => os.write(out / "main.js.map", ujson.write(map))
          case Left(message) => Task.fail(message)
        }
        // A shebang in front of main.js would shift its source map by a line.
        os.write(
          out / "bin" / "ears-check.js",
          "#!/usr/bin/env node\nimport \"../main.js\";\n",
          perms = "rwxr-xr-x",
          createFolders = true
        )
        os.copy(packageFiles().path / "README.md", out / "README.md")
        os.copy(npm.license().path, out / "LICENSE")
        val parser = "mdast-util-from-markdown"
        val lockfile = markdown.js.npmManifest().map(_.path).filter(_.last == "package-lock.json")
        val pinned = lockfile.headOption
          .flatMap(file => ujson.read(os.read(file))("packages").obj.get(s"node_modules/$parser"))
          .map(_("version").str)
          .getOrElse(Task.fail(s"$parser isn't in ears/markdown/js/package-lock.json"))
        val repository = "https://github.com/tsnee/ears-checker"
        val manifest = ujson.Obj(
          "name" -> "@tsnee/ears-checker-cli",
          "version" -> npm.npmVersion(),
          "description" -> cli.pomDescription,
          "keywords" -> ujson.Arr(
            "ears", "requirements", "requirements-engineering", "lint", "cli", "markdown",
            "openspec"
          ),
          "homepage" -> s"$repository#readme",
          "bugs" -> ujson.Obj("url" -> s"$repository/issues"),
          "repository" -> ujson.Obj("type" -> "git", "url" -> s"git+$repository.git"),
          "license" -> "CC0-1.0",
          "type" -> "module",
          "bin" -> ujson.Obj("ears-check" -> "./bin/ears-check.js"),
          "files" -> ujson.Arr("main.js", "main.js.map", "bin/ears-check.js"),
          "dependencies" -> ujson.Obj(parser -> pinned),
          "engines" -> ujson.Obj("node" -> ">=22")
        )
        os.write(out / "package.json", ujson.write(manifest, indent = 2) + "\n")
        PathRef(out)
      }
    }
  }

  /** Writes a program that references every public operation of the library, from the library's
    * SemanticDB; `scripts/check-scalajs-link` links it against the published Scala.js artifact.
    * Not published.
    */
  object linkCheck extends Base with Covered {
    def mvnDeps = Seq(
      mvn"dev.zio::zio:$zioVersion",
      mvn"org.scalameta:semanticdb-shared_2.13:4.17.4"
    )

    def statementCoverageMin = Some(96.0)
    def branchCoverageMin = Some(100.0)

    object test extends CoveredTests with ZioSpecs {
      // The Scala.js library's SemanticDB (shared and Scala.js-only sources: what's published),
      // and the fixture's, for the tests that run the rules on real compiler output.
      def forkEnv = Task {
        super.forkEnv() ++ Map(
          "EARS_SEMANTICDB" -> ears.js.semanticDbData().path.toString,
          "FIXTURE_SEMANTICDB" -> fixture.semanticDbData().path.toString
        )
      }
    }

    /** Every operation shape the generator handles; `scripts/check-scalajs-link` compiles the
      * program generated from it. Not published.
      */
    object fixture extends Base
  }
}
